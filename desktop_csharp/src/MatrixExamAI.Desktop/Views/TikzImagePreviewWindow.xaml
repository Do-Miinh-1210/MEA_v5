<Window x:Class="MatrixExamAI.Desktop.Views.TikzImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Xem Hình Vẽ TikZ Độ Phân Giải Cao"
        Height="760" Width="1060" MinWidth="750" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Focusable="True"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        KeyDown="TikzImagePreviewWindow_KeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header / Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Image24" FontSize="16" Foreground="#8B5CF6" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtTitleInfo" Text="Xem hình vẽ TikZ chi tiết" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0" />

                    <!-- Zoom Controls -->
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4" Height="26" Padding="3,0" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="BtnZoomOut" Appearance="Transparent" Content="-" Width="24" Height="22" Padding="0" FontSize="13" Click="BtnZoomOut_Click" ToolTip="Thu nhỏ (Lăn chuột xuống hoặc phím -)" />
                            <ui:Button x:Name="BtnZoomReset" Appearance="Transparent" Content="100%" Height="22" Padding="6,0" FontSize="10" Click="BtnZoomReset_Click" ToolTip="Kích thước gốc 100% (Ctrl+0)" />
                            <ui:Button x:Name="BtnZoomIn" Appearance="Transparent" Content="+" Width="24" Height="22" Padding="0" FontSize="13" Click="BtnZoomIn_Click" ToolTip="Phóng to (Lăn chuột lên hoặc phím +)" />
                            <ui:Button x:Name="BtnZoomFit" Appearance="Transparent" Content="Vừa khung" Height="22" Padding="6,0" FontSize="10" Click="BtnZoomFit_Click" ToolTip="Vừa vặn khung nhìn (Nhấp đúp chuột)" />
                            <ui:Button x:Name="BtnZoom200" Appearance="Transparent" Content="200%" Height="22" Padding="6,0" FontSize="10" Click="BtnZoom200_Click" ToolTip="Phóng đại 200%" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TxtZoomLevel" Text="Thu phóng: 100%" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Action buttons right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnCopyImage" Icon="{ui:SymbolIcon Copy24}" Content="Sao chép ảnh" 
                               Appearance="Secondary" Height="26" Padding="8,0" Margin="0,0,4,0" FontSize="10.5" 
                               Click="BtnCopyImage_Click" ToolTip="Sao chép ảnh vào Clipboard (Ctrl+C)" />
                    <ui:Button x:Name="BtnSaveImage" Icon="{ui:SymbolIcon ArrowDownload24}" Content="Lưu tệp..." 
                               Appearance="Secondary" Height="26" Padding="8,0" Margin="0,0,4,0" FontSize="10.5" 
                               Click="BtnSaveImage_Click" ToolTip="Lưu tệp ảnh độ nét cao (Ctrl+S)" />
                    <ui:Button x:Name="BtnOpenExternal" Icon="{ui:SymbolIcon Open24}" Content="Mở ngoài" 
                               Appearance="Secondary" Height="26" Padding="8,0" Margin="0,0,6,0" FontSize="10.5" 
                               Click="BtnOpenExternal_Click" ToolTip="Mở file ảnh bằng ứng dụng mặc định của hệ thống" />
                    <ui:Button x:Name="BtnClose" Icon="{ui:SymbolIcon Dismiss24}" Content="Đóng" 
                               Appearance="Primary" Height="26" Padding="12,0" FontSize="10.5" 
                               Click="BtnClose_Click" ToolTip="Đóng cửa sổ xem hình (Esc)" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Image Canvas Viewer (Dark Slate Studio Canvas) -->
        <Border Grid.Row="1" Background="#0F172A" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <Grid x:Name="ViewportContainer" ClipToBounds="True" Background="#0F172A"
                  MouseDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseUp="Canvas_MouseUp" Cursor="Hand">
                <Grid x:Name="CanvasContainer" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Background="Transparent">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ImgScaleTransform" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="ImgTranslateTransform" X="0" Y="0" />
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <!-- Khung Card bao bọc hình ảnh TikZ trang nhã, đổ bóng nổi bật -->
                    <Border x:Name="BorderImageCard" Background="#FFFFFF"
                            BorderBrush="#475569" BorderThickness="1" CornerRadius="4"
                            Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" Color="#000000" Opacity="0.45" ShadowDepth="4" Direction="270" />
                        </Border.Effect>
                        <Image x:Name="ImgFullPreview" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Footer / Status Bar -->
        <DockPanel Grid.Row="2" Margin="0,6,0,0" LastChildFill="False">
            <TextBlock x:Name="TxtFooterInfo" DockPanel.Dock="Left" Text="Lăn chuột để phóng to/thu nhỏ | Kéo giữ chuột để di chuyển | Nhấp đúp để vừa khung | Nhấn Esc để đóng" 
                       FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="TxtResolutionInfo" DockPanel.Dock="Right" Text="0 × 0 px" 
                       FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
