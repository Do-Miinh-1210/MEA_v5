<Window x:Class="MatrixExamAI.Desktop.Views.SmartPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Smart Prompt — Trợ lý AI Soạn đề &amp; Câu hỏi" Height="700" Width="960" MinHeight="620" MinWidth="850"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ApplicationBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        TextElement.FontFamily="Segoe UI" TextElement.FontSize="12">
    <Window.Resources>
        <!-- Style TabItem chuẩn Dark/Light mode: không bị nền trắng che mất chữ -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" CornerRadius="6,6,0,0" Padding="18,8" Margin="0,0,4,0"
                                Background="Transparent" BorderThickness="1,1,1,0" BorderBrush="Transparent">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F2D52" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Chat24" Foreground="#A78BFA" FontSize="22" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="SMART PROMPT — Trợ lý AI Soạn Đề &amp; Câu Hỏi Tự Nhiên"
                                   Foreground="White" FontSize="14" FontWeight="Bold" />
                        <TextBlock Text="Biến mô tả tiếng Việt tự nhiên thành đề thi, ma trận đặc tả hoặc câu hỏi chuẩn LaTeX ex_test"
                                   Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#8B5CF6" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="AI Sư phạm 2025" Foreground="White" FontSize="11" FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>

        <!-- Main Body -->
        <TabControl Grid.Row="1" Margin="12,8,12,4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
            
            <!-- TAB 1: TẠO ĐỀ BẰNG MÔ TẢ TỰ NHIÊN -->
            <TabItem Header="  📄 Phân tích yêu cầu tạo đề  " FontWeight="SemiBold">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Nhập mô tả đề thi bằng tiếng Việt tự nhiên (hoặc bấm chọn gợi ý mẫu nhanh):"
                               FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />

                    <!-- Ô nhập mô tả -->
                    <TextBox Grid.Row="1" x:Name="TxtExamPromptInput" Height="75" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Padding="8,6" FontSize="12"
                             Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                             Text="Đề kiểm tra 45 phút môn Toán 12 chương Đạo hàm và ứng dụng, gồm 12 câu trắc nghiệm 4 lựa chọn, 2 câu đúng sai và 3 câu trả lời ngắn." />

                    <!-- Gợi ý mẫu nhanh -->
                    <StackPanel Grid.Row="2" Margin="0,8,0,8">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Gợi ý nhanh:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                            <Button Content="⚡ 15 phút (7 TN)" Margin="0,0,6,4" Padding="8,4" FontSize="11"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Click="BtnPreset15m_Click" />
                            <Button Content="📚 45 phút (12 TN + 2 ĐS + 3 TLN)" Margin="0,0,6,4" Padding="8,4" FontSize="11"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Click="BtnPreset45m_Click" />
                            <Button Content="📝 60 phút (15 TN + 3 ĐS + 4 TLN)" Margin="0,0,6,4" Padding="8,4" FontSize="11"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Click="BtnPreset60m_Click" />
                            <Button Content="🏆 90 phút chuẩn BGD (12 TN + 4 ĐS + 6 TLN)" Margin="0,0,6,4" Padding="8,4" FontSize="11"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Click="BtnPreset90m_Click" />
                        </WrapPanel>

                        <!-- Action buttons hàng 1 -->
                        <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="BtnParseExamPrompt" Content="🔍 AI Phân tích cấu trúc đề" Height="32" Padding="14,0" Margin="0,0,8,0"
                                    Background="#2563EB" Foreground="White" FontWeight="Bold" Click="BtnParseExamPrompt_Click" />
                            <Button x:Name="BtnApplyToMatrix" Content="✓ Áp dụng vào Tạo đề / Ma trận" Height="32" Padding="14,0" Margin="0,0,8,0"
                                    Background="#10B981" Foreground="White" FontWeight="Bold" IsEnabled="False" Click="BtnApplyToMatrix_Click" />
                            <Button x:Name="BtnCopyLatexPrompt" Content="📋 Sao chép Prompt chuẩn LaTeX" Height="32" Padding="12,0"
                                    Background="#475569" Foreground="White" FontWeight="SemiBold" Click="BtnCopyLatexPrompt_Click" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Kết quả phân tích / Xem trước ma trận -->
                    <GroupBox Grid.Row="3" Header="Kết quả phân tích cấu trúc &amp; Ma trận đề" Padding="8,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" x:Name="BorderParsedSummary" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6" Visibility="Collapsed">
                                <TextBlock x:Name="TxtParsedSummary" FontWeight="SemiBold" Foreground="#38BDF8" FontSize="11.5" />
                            </Border>
                            <TextBox Grid.Row="1" x:Name="TxtParsedDetails" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5" Padding="8,6"
                                     Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     Text="Bấm 'AI Phân tích cấu trúc đề' để AI tự động trích xuất Môn, Lớp, Thời lượng, số lượng câu từng dạng (TN, Đúng/Sai, Trả lời ngắn) và lập khung ma trận." />
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- TAB 2: AI SOẠN NHANH 1 CÂU HỎI -->
            <TabItem Header="  ✏️ AI Soạn nhanh 1 câu hỏi  " FontWeight="SemiBold">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Lựa chọn thông số câu hỏi -->
                    <GroupBox Grid.Row="0" Header="Thông số câu hỏi cần tạo" Padding="8,6" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                                <TextBlock Text="Môn:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ComboBox x:Name="CmbQuestionSubject" Width="115" Height="32" VerticalContentAlignment="Center" SelectedIndex="0">
                                    <ComboBoxItem Content="Toán" />
                                    <ComboBoxItem Content="Vật lý" />
                                    <ComboBoxItem Content="Hóa học" />
                                    <ComboBoxItem Content="Sinh học" />
                                    <ComboBoxItem Content="Ngữ văn" />
                                    <ComboBoxItem Content="Tiếng Anh" />
                                    <ComboBoxItem Content="Lịch sử" />
                                    <ComboBoxItem Content="Địa lý" />
                                    <ComboBoxItem Content="Tin học" />
                                    <ComboBoxItem Content="Công nghệ" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                                <TextBlock Text="Lớp:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ComboBox x:Name="CmbQuestionGrade" Width="78" Height="32" VerticalContentAlignment="Center" SelectedIndex="6">
                                    <ComboBoxItem Content="6" />
                                    <ComboBoxItem Content="7" />
                                    <ComboBoxItem Content="8" />
                                    <ComboBoxItem Content="9" />
                                    <ComboBoxItem Content="10" />
                                    <ComboBoxItem Content="11" />
                                    <ComboBoxItem Content="12" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                                <TextBlock Text="Loại câu:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ComboBox x:Name="CmbQuestionType" Width="155" Height="32" VerticalContentAlignment="Center" SelectedIndex="0">
                                    <ComboBoxItem Content="TN (Trắc nghiệm 4 lựa chọn)" Tag="TN" />
                                    <ComboBoxItem Content="DS (Đúng / Sai 4 ý)" Tag="DS" />
                                    <ComboBoxItem Content="TLN (Trả lời ngắn)" Tag="TLN" />
                                    <ComboBoxItem Content="TL (Tự luận bài tập)" Tag="TL" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <TextBlock Text="Mức độ:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ComboBox x:Name="CmbQuestionLevel" Width="135" Height="32" VerticalContentAlignment="Center" SelectedIndex="1">
                                    <ComboBoxItem Content="Nhận biết" />
                                    <ComboBoxItem Content="Thông hiểu" />
                                    <ComboBoxItem Content="Vận dụng" />
                                    <ComboBoxItem Content="Vận dụng cao" />
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>
                    </GroupBox>

                    <!-- Nội dung yêu cầu và Nút sinh câu hỏi -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Yêu cầu chi tiết nội dung hoặc chủ đề bài toán:" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBox Grid.Row="1" x:Name="TxtQuestionRequirement" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Padding="8,4" FontSize="12"
                                 Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                 Text="Bài toán tìm cực trị hàm số bậc ba hoặc hàm trùng phương, có yếu tố thực tế hoặc bảng biến thiên." />

                        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="BtnGenerateSingleQuestion" Content="⚡ AI Sinh câu hỏi ngay" Height="32" Padding="14,0" Margin="0,0,8,0"
                                    Background="#7C3AED" Foreground="White" FontWeight="Bold" Click="BtnGenerateSingleQuestion_Click" />
                            <Button x:Name="BtnInsertQuestionToEditor" Content="Đưa vào Soạn đề" Height="32" Padding="14,0" Margin="0,0,8,0"
                                    Background="#10B981" Foreground="White" FontWeight="Bold" IsEnabled="False" Click="BtnInsertQuestionToEditor_Click" />
                            <Button x:Name="BtnCopySingleQuestion" Content="Sao chép LaTeX" Height="32" Padding="12,0"
                                    Background="#475569" Foreground="White" FontWeight="SemiBold" IsEnabled="False" Click="BtnCopySingleQuestion_Click" />
                        </WrapPanel>
                    </Grid>

                    <!-- Khung xem trước câu hỏi -->
                    <GroupBox Grid.Row="2" Header="Nội dung câu hỏi sinh ra (Chuẩn LaTeX ex_test có đáp án &amp; lời giải)"
                              Padding="8,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <TextBox x:Name="TxtQuestionOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5" Padding="8,6"
                                 Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 Text="Bấm 'AI Sinh câu hỏi ngay' để AI tạo câu hỏi hoàn chỉnh với cú pháp LaTeX chuẩn ex_test." />
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- TAB 3: THƯ VIỆN PROMPT SƯ PHẠM CHUẨN -->
            <TabItem Header="  📚 Thư viện Prompt sư phạm  " FontWeight="SemiBold">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Các mẫu prompt AI sư phạm chuẩn hoá đề thi dành cho ChatGPT, Gemini, Claude:"
                               FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Danh sách mẫu prompt -->
                        <Border Grid.Column="0" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                                CornerRadius="4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="4" Margin="0,0,8,0">
                            <ListBox x:Name="LstPromptTemplates" SelectionChanged="LstPromptTemplates_SelectionChanged"
                                     Background="Transparent" BorderThickness="0" FontSize="11.5">
                                <ListBoxItem Content="1. Mẫu Tạo đề chuẩn ex_test (4 dạng)" IsSelected="True" Padding="8,6" />
                                <ListBoxItem Content="2. Mẫu Lập ma trận đề chuẩn BGD 2025" Padding="8,6" />
                                <ListBoxItem Content="3. Mẫu Sinh câu hỏi thực tế liên môn" Padding="8,6" />
                                <ListBoxItem Content="4. Mẫu Bắt lỗi cú pháp &amp; Chuẩn hóa đề" Padding="8,6" />
                                <ListBoxItem Content="5. Mẫu Vẽ hình Toán học TikZ tự động" Padding="8,6" />
                            </ListBox>
                        </Border>

                        <!-- Nội dung mẫu được chọn -->
                        <TextBox Grid.Column="1" x:Name="TxtTemplateContent" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Padding="8,6"
                                 Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 BorderBrush="{DynamicResource ControlElevationBorderBrush}" />
                    </Grid>

                    <!-- Nút thao tác mẫu -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="📋 Sao chép mẫu này" MinWidth="160" Height="32" Padding="14,0" Margin="0,0,8,0"
                                Background="#0284C7" Foreground="White" FontWeight="Bold" Click="BtnCopyTemplate_Click" />
                        <Button Content="Nạp vào ô Soạn đề" MinWidth="150" Height="32" Padding="14,0"
                                Background="#10B981" Foreground="White" FontWeight="Bold" Click="BtnLoadTemplateToEditor_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Footer Bar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar x:Name="PrgBusy" IsIndeterminate="True" Width="80" Height="4" Margin="0,0,10,0" Visibility="Collapsed" />
                    <TextBlock x:Name="TxtStatus" Text="Sẵn sàng." FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1" Content="Đóng" Width="90" Height="30"
                        Background="#64748B" Foreground="White" FontWeight="SemiBold" Click="BtnClose_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
