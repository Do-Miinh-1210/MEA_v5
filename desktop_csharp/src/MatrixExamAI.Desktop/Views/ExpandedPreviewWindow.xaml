<ui:FluentWindow x:Class="MatrixExamAI.Desktop.Views.ExpandedPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Khung xem trước tài liệu riêng biệt • MatrixExamAI" 
        Height="820" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        PreviewKeyDown="ExpandedPreviewWindow_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Khung xem trước tài liệu riêng biệt • MatrixExamAI Pro">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border Width="20" Height="20" CornerRadius="4" Background="#0284C7" Margin="0,0,8,0">
                        <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Xem trước tài liệu độc lập" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- 2. Thanh công cụ phía trên -->
        <Border Grid.Row="1" Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Chế độ xem: Word A4 / Bảng câu hỏi / Mã nguồn -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RbTabWord" Content="Trang in Word A4" IsChecked="True" 
                                 GroupName="ExpandedTabs" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold"
                                 Checked="RbTab_Checked" />
                    <RadioButton x:Name="RbTabGrid" Content="Bảng câu hỏi chi tiết" 
                                 GroupName="ExpandedTabs" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold"
                                 Checked="RbTab_Checked" />
                    <RadioButton x:Name="RbTabRaw" Content="{}{Mã nguồn kẹp ${...}$}" 
                                 GroupName="ExpandedTabs" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold"
                                 Checked="RbTab_Checked" />
                </WrapPanel>

                <!-- Thao tác nhanh -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnExportWord" Appearance="Primary" 
                               Icon="{ui:SymbolIcon DocumentArrowRight24}"
                               Content="Xuất file Word (.docx)" Padding="12,5" Margin="0,0,8,0" FontSize="11.5"
                               Click="BtnExportWord_Click"
                               ToolTip="Xuất tài liệu Word chuẩn Microsoft Word A4 (Ctrl + S)" />
                    <ui:Button x:Name="BtnCopy" Appearance="Secondary" 
                               Icon="{ui:SymbolIcon Copy24}"
                               Content="Sao chép" Padding="10,5" Margin="0,0,8,0" FontSize="11.5"
                               Click="BtnCopy_Click"
                               ToolTip="Sao chép toàn bộ nội dung xem trước vào bộ nhớ tạm (Ctrl + C)" />
                    <ui:Button x:Name="BtnClose" Appearance="Transparent" 
                               Icon="{ui:SymbolIcon Dismiss24}"
                               Content="Đóng" Padding="10,5" FontSize="11.5"
                               Click="BtnClose_Click"
                               ToolTip="Đóng cửa sổ xem trước riêng biệt (Esc)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Khu vực hiển thị nội dung chính -->
        <Grid Grid.Row="2" Margin="16,12">
            <!-- Chế độ 1: Mô phỏng Word A4 -->
            <Border x:Name="BorderWordContainer" Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="6" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Border Margin="24" Background="#FFFFFF" TextElement.Foreground="#0F172A" CornerRadius="4" Padding="32" 
                            MaxWidth="820" HorizontalAlignment="Stretch">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" Opacity="0.12" ShadowDepth="3" />
                        </Border.Effect>
                        <StackPanel x:Name="PanelDocContent" />
                    </Border>
                </ScrollViewer>
            </Border>

            <!-- Chế độ 2: DataGrid câu hỏi toàn màn hình -->
            <Border x:Name="BorderGridContainer" Visibility="Collapsed"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="6" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="12,8" CornerRadius="6,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Table24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtGridHeader" Text="Bảng danh sách câu hỏi đã nhận diện" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="DgQuestionsExpanded" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="Transparent" RowBackground="Transparent"
                              BorderThickness="0" SelectionMode="Single"
                              FontFamily="Segoe UI" FontSize="11.5"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Padding" Value="8,4,8,4" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="11.5" />
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6,4,6,4" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Padding" Value="4,2" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Môn/Lớp" Binding="{Binding SubjectGrade}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="4,2" />
                                        <Setter Property="ToolTip" Value="{Binding SubjectGrade}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Loại" Binding="{Binding TypeShort}" Width="65">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="4,2" />
                                        <Setter Property="ToolTip" Value="{Binding TypeShort}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Mức độ" Binding="{Binding CognitiveLevel}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="4,2" />
                                        <Setter Property="ToolTip" Value="{Binding CognitiveLevel}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Chủ đề" Binding="{Binding Topic}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="4,2" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Topic}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Đáp án" Binding="{Binding CorrectAnswer}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="#10B981" />
                                        <Setter Property="Padding" Value="4,2" />
                                        <Setter Property="ToolTip" Value="{Binding CorrectAnswer}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Nội dung câu hỏi" Binding="{Binding ContentPreview}" Width="2*" MinWidth="250">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="4,2" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding ContentPreview}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Lời giải chi tiết" Binding="{Binding ExplanationPreview}" Width="1.5*" MinWidth="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="4,2" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding ExplanationPreview}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Chế độ 3: TextBox mã nguồn thô -->
            <ui:TextBox x:Name="TxtRawSource" Visibility="Collapsed"
                        IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                        VerticalContentAlignment="Top"
                        FontFamily="Consolas, 'Cascadia Code', 'Segoe UI', Arial" FontSize="12.5"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Grid>

        <!-- 4. Footer thống kê trạng thái -->
        <Border Grid.Row="3" Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <TextBlock x:Name="TxtFooterStats" Text="Xem trước tài liệu" FontSize="11" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Bản quyền MatrixExamAI Pro" FontSize="10.5" 
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
