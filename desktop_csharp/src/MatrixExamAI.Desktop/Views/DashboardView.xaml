<UserControl x:Class="MatrixExamAI.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,20,20">
            <!-- Header Welcome -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/MatrixExamAI.Desktop;component/Assets/logo.png" Width="52" Height="52" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Chào mừng Thầy Đỗ Minh 👋" 
                                   FontSize="24" FontWeight="Bold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Hệ thống biên soạn đề thi thông minh MatrixExamAI Pro (.NET 10 Native C# Engine)" 
                                   FontSize="13" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnQuickConvert" Appearance="Primary" 
                               Icon="{ui:SymbolIcon ArrowForward24}"
                               Content="Chuyển đổi đề mới" 
                               Padding="16,8" Margin="0,0,10,0" 
                               Click="BtnQuickConvert_Click"
                               ToolTip="Chuyển sang phân hệ Chuyển đổi đề thi (Ctrl + 2)" />
                    <ui:Button x:Name="BtnOpenFolder" Appearance="Secondary" 
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Content="Mở thư mục đề" 
                               Padding="16,8" 
                               Click="BtnOpenFolder_Click"
                               ToolTip="Mở thư mục chứa các đề thi đã xuất trên máy" />
                </StackPanel>
            </Grid>

            <!-- Metrics Cards Grid -->
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <!-- Card 1: Khởi động -->
                <ui:Card Margin="0,0,12,0" Padding="16" MinWidth="140">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Khởi động &amp; Render" FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:SymbolIcon Symbol="Flash24" HorizontalAlignment="Right" 
                                           Foreground="#F59E0B" />
                        </Grid>
                        <TextBlock Text="0.3s" FontSize="26" FontWeight="Bold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="⚡ Nhanh hơn Python 12x" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="#10B981" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:Card>

                <!-- Card 2: Bộ nhớ RAM -->
                <ui:Card Margin="6,0,6,0" Padding="16" MinWidth="140">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Bộ nhớ RAM" FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:SymbolIcon Symbol="DeveloperBoard24" HorizontalAlignment="Right" 
                                           Foreground="#3B82F6" />
                        </Grid>
                        <TextBlock Text="38 MB" FontSize="26" FontWeight="Bold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="✓ Tiết kiệm 85% RAM" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="#10B981" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:Card>

                <!-- Card 3: Công thức Toán -->
                <ui:Card Margin="6,0,6,0" Padding="16" MinWidth="140">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Công thức Toán" FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:SymbolIcon Symbol="MathFormula24" HorizontalAlignment="Right" 
                                           Foreground="#A855F7" />
                        </Grid>
                        <TextBlock Text="${...}$" FontSize="26" FontWeight="Bold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="✓ Kẹp chuẩn 100% Word" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="#0D9488" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:Card>

                <!-- Card 4: FPS -->
                <ui:Card Margin="12,0,0,0" Padding="16" MinWidth="140">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Tốc độ khung hình" FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:SymbolIcon Symbol="Desktop24" HorizontalAlignment="Right" 
                                           Foreground="#10B981" />
                        </Grid>
                        <TextBlock Text="120 FPS" FontSize="26" FontWeight="Bold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="DirectX GPU Acceleration" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <!-- Feature Showcase -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Showcase: Convert -->
                <ui:CardAction Grid.Column="0" Margin="0,0,10,0" Padding="20" Click="BtnQuickConvert_Click">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentPdf24" Foreground="#3B82F6" Margin="0,0,8,0" />
                                <TextBlock Text="Chuyển đổi PDF sang Word Native" FontWeight="SemiBold" FontSize="15" />
                            </StackPanel>
                            <Border Background="#1A0D9488" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="Auto Table Grid" FontSize="10" Foreground="#0D9488" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock Text="Tự động nhận diện cấu trúc bảng trả về dấu gạch đứng | để chuyển thành bảng Word Table Grid native, đồng thời bảo vệ công thức toán học |x| &lt; 3 không bị cắt nhầm cột."
                                   TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,12" />
                        <TextBlock Text="Bấm để mở phân hệ Chuyển đổi →" FontSize="12" FontWeight="SemiBold" Foreground="#0D9488" />
                    </StackPanel>
                </ui:CardAction>

                <!-- Right Showcase: TikZ -->
                <ui:CardAction Grid.Column="1" Margin="10,0,0,0" Padding="20" Click="BtnTikz_Click">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Shapes24" Foreground="#10B981" Margin="0,0,8,0" />
                                <TextBlock Text="AI Vẽ hình toán học TikZ 2 chiều" FontWeight="SemiBold" FontSize="15" />
                            </StackPanel>
                            <Border Background="#1AA855F7" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="Word Add-in Sync" FontSize="10" Foreground="#A855F7" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock Text="Vẽ đồ thị Oxy, hình không gian 3D, bảng biến thiên chuẩn SGK mới. Mã nguồn TikZ được nhúng thẳng vào thuộc tính ảnh trong Word để click đúp sửa lại tức thì."
                                   TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,12" />
                        <TextBlock Text="Đồng bộ trực tiếp cùng Microsoft Word →" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" />
                    </StackPanel>
                </ui:CardAction>
            </Grid>

            <!-- Status Banner -->
            <ui:Card Padding="16" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#10B981" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Môi trường C# .NET 10 đã kết nối thành công" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Thư viện lõi MatrixExamAI.Shared và tiện ích Microsoft Word Add-in sẵn sàng hoạt động song song." 
                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="#1A10B981" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="Ready &amp; Stable" Foreground="#10B981" FontSize="11" FontWeight="Bold" />
                    </Border>
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
