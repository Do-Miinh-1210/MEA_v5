<UserControl x:Class="MatrixExamAI.Desktop.Views.QcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">
    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="CheckmarkSquare24" FontSize="24" Foreground="#10B981" Margin="0,0,10,0" />
                    <TextBlock Text="Thẩm định Đề thi (Quality Control - QC)" 
                               FontSize="20" FontWeight="Bold" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <TextBlock Text="Tự động rà soát phát hiện lỗi: Trùng lặp phương án A-B-C-D, thiếu đáp án đúng, lỗi cú pháp LaTeX, vi phạm chuẩn format BGD" 
                           FontSize="12" Margin="34,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Thanh hành động (WrapPanel chống tràn) -->
        <ui:Card Grid.Row="1" Margin="0,0,0,14" Padding="10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ChkCheckDupOptions" IsChecked="True" Content="Trùng lặp phương án" Margin="0,0,14,4" FontSize="11" />
                <CheckBox x:Name="ChkCheckMissingAns" IsChecked="True" Content="Thiếu đáp án đúng" Margin="0,0,14,4" FontSize="11" />
                <CheckBox x:Name="ChkCheckLatexSyntax" IsChecked="True" Content="Lỗi cú pháp LaTeX" Margin="0,0,14,4" FontSize="11" />
                <CheckBox x:Name="ChkCheckFormat" IsChecked="True" Content="Sai quy chuẩn BGD" Margin="0,0,16,4" FontSize="11" />

                <ui:Button x:Name="BtnRunQc" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Content="Chạy Thẩm định Đề thi" Padding="12,5" Margin="0,0,6,4" FontSize="11" Click="BtnRunQc_Click" ToolTip="Rà soát lỗi trùng phương án, thiếu đáp án, sai cú pháp LaTeX (F5)" />
                <ui:Button x:Name="BtnAutoFix" Appearance="Success" Icon="{ui:SymbolIcon Sparkle24}" Content="AI Tự động sửa lỗi" Padding="12,5" Margin="0,0,0,4" FontSize="11" Click="BtnAutoFix_Click" ToolTip="AI tự động sửa các lỗi cú pháp và chuẩn hóa đề thi" />
            </WrapPanel>
        </ui:Card>

        <!-- Báo cáo kết quả thẩm định -->
        <ui:Card Grid.Row="2" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Báo cáo chi tiết các cảnh báo &amp; Lỗi phát hiện được" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="TxtQcSummary" Text="Đề thi hợp lệ: 0 lỗi nghiêm trọng, 1 cảnh báo nhỏ" FontSize="11" HorizontalAlignment="Right" 
                               Foreground="#10B981" FontWeight="SemiBold" />
                </Grid>

                <ui:TextBox x:Name="TxtQcReport" Grid.Row="1" IsReadOnly="False" AcceptsReturn="True" TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            PlaceholderText="Nhập hoặc dán nội dung đề thi vào đây để thẩm định, hoặc bấm 'Chạy Thẩm định Đề thi' để quét đề hiện tại..."
                            FontFamily="Consolas, 'Segoe UI', Arial" FontSize="12.5"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Grid>
        </ui:Card>

        <!-- InfoBar -->
        <ui:InfoBar x:Name="InfoQcNotification" Grid.Row="3" Margin="0,12,0,0"
                    IsOpen="False" Severity="Success"
                    Title="Thẩm định hoàn tất" 
                    Message="Đề thi đạt tiêu chuẩn xuất bản và in ấn chính thức." />
    </Grid>
</UserControl>
