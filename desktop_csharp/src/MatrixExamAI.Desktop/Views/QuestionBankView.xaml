<UserControl x:Class="MatrixExamAI.Desktop.Views.QuestionBankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">
    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Archive24" FontSize="24" Foreground="#059669" Margin="0,0,10,0" />
                    <TextBlock Text="Ngân hàng Câu hỏi &amp; Thư viện Đề thi SQLite Native" 
                               FontSize="20" FontWeight="Bold" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <TextBlock Text="Lưu trữ câu hỏi phân loại theo Chuyên đề, Mức độ nhận thức (NB - TH - VD - VDC), tìm kiếm siêu tốc 0.05s" 
                           FontSize="12" Margin="34,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Thanh tìm kiếm & Lọc (WrapPanel chống tràn thích ứng) -->
        <ui:Card Grid.Row="1" Margin="0,0,0,14" Padding="10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBox x:Name="TxtSearch" PlaceholderText="Tìm kiếm câu hỏi theo từ khóa, chuyên đề..." Width="220" MinWidth="160" Height="32" Margin="0,0,8,4" FontSize="11.5" VerticalContentAlignment="Center" />
                <ComboBox x:Name="CmbLevelFilter" Width="135" Height="32" SelectedIndex="0" Margin="0,0,8,4" FontSize="11.5" 
                          Padding="8,0,24,0" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Tất cả mức độ" Padding="8,4" />
                    <ComboBoxItem Content="Nhận biết" Padding="8,4" />
                    <ComboBoxItem Content="Thông hiểu" Padding="8,4" />
                    <ComboBoxItem Content="Vận dụng" Padding="8,4" />
                    <ComboBoxItem Content="Vận dụng cao" Padding="8,4" />
                </ComboBox>
                <ui:Button x:Name="BtnSearch" Appearance="Secondary" Icon="{ui:SymbolIcon Search24}" Content="Tìm kiếm" Padding="10,5" Margin="0,0,6,4" FontSize="11" Click="BtnSearch_Click" ToolTip="Tìm kiếm câu hỏi trong SQLite database (F5 hoặc Enter)" />
                <ui:Button x:Name="BtnRefreshBank" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowSync24}" Content="Làm mới" Padding="10,5" Margin="0,0,6,4" FontSize="11" Click="BtnRefreshBank_Click" ToolTip="Tải lại toàn bộ câu hỏi từ SQLite Database (F5)" />
                <ui:Button x:Name="BtnImportConvert" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowDownload24}" Content="Nạp từ ConvertView" Padding="10,5" Margin="0,0,6,4" FontSize="11" Click="BtnImportConvert_Click" ToolTip="Nhập nhanh các câu hỏi vừa nhận diện từ ConvertView vào Ngân hàng SQLite" />
                <ui:Button x:Name="BtnAddQuestion" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Thêm câu hỏi mới" Padding="12,5" Margin="0,0,6,4" FontSize="11" Click="BtnAddQuestion_Click" ToolTip="Thêm câu hỏi mới vào ngân hàng câu hỏi SQLite" />
                <ui:Button x:Name="BtnExportSelected" Appearance="Success" Icon="{ui:SymbolIcon DocumentArrowRight24}" Content="Xuất đề thi Word" Padding="12,5" Margin="0,0,0,4" FontSize="11" Click="BtnExportSelected_Click" ToolTip="Xuất danh sách câu hỏi đã chọn ra tệp Word (Ctrl + S)" />
            </WrapPanel>
        </ui:Card>

        <!-- Danh sách câu hỏi -->
        <ui:Card Grid.Row="2" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Danh sách câu hỏi trong Ngân hàng dữ liệu (SQLite)" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="TxtBankCount" Text="Hiển thị: 25 câu hỏi mẫu" FontSize="11" HorizontalAlignment="Right" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>

                <DataGrid x:Name="GridQuestions" Grid.Row="1" AutoGenerateColumns="False" 
                          CanUserAddRows="False" HeadersVisibility="Column" 
                          GridLinesVisibility="Horizontal" RowHeight="36"
                          BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã ID" Binding="{Binding Id}" Width="70" />
                        <DataGridTextColumn Header="Mức độ" Binding="{Binding Level}" Width="110" />
                        <DataGridTextColumn Header="Chuyên đề" Binding="{Binding Topic}" Width="160" />
                        <DataGridTextColumn Header="Nội dung tóm tắt câu hỏi" Binding="{Binding ContentPreview}" Width="*" />
                        <DataGridTextColumn Header="Đáp án" Binding="{Binding CorrectAnswer}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </ui:Card>

        <!-- InfoBar -->
        <ui:InfoBar x:Name="InfoBankNotification" Grid.Row="3" Margin="0,12,0,0"
                    IsOpen="False" Severity="Success"
                    Title="Ngân hàng câu hỏi" 
                    Message="Đã nạp cơ sở dữ liệu SQLite thành công." />
    </Grid>
</UserControl>
