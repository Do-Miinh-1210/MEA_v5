<UserControl x:Class="MatrixExamAI.Desktop.Views.ConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header & Bộ đếm thời gian (Sleek & Compact) -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="6" Background="#0284C7" Margin="0,0,8,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Chuyển đổi &amp; Chuẩn hóa Đề thi Word" 
                           FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Border Background="#1A0284C7" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text=".NET 10 Native" FontSize="9.5" Foreground="#0284C7" FontWeight="SemiBold" />
                </Border>
                <TextBlock x:Name="TxtCurrentFile" Text="Chưa chọn tệp" 
                           MaxWidth="260" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           FontSize="11" FontStyle="Italic" VerticalAlignment="Center" Margin="14,0,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <!-- Đồng hồ xử lý Realtime -->
            <Border Grid.Column="1" Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Timer24" FontSize="13" Foreground="#0EA5E9" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtTimer" Text="00:00:00.0" FontSize="13" FontWeight="Bold" 
                               FontFamily="Consolas, 'Cascadia Code', Segoe UI" Foreground="#0EA5E9" VerticalAlignment="Center" />
                    <Ellipse x:Name="DotTimerStatus" Width="6" Height="6" Fill="#10B981" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Thanh điều khiển chính (2 Hàng cực kỳ tinh gọn, không tràn dòng) -->
        <ui:Card Grid.Row="1" Margin="0,0,0,8" Padding="8,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Hàng 1: Nạp tệp chính, Bộ chọn Lớp/Môn, Nhận diện & Xuất Word -->
                <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="False">
                    <!-- Cụm trái: Mở tệp, Dán, Ghi đè/Nối tiếp, Xóa, Lớp, Môn, Trang -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="BtnOpenFile" Appearance="Primary" 
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Content="Mở tệp" Height="28" Padding="8,0" Margin="0,0,3,0" FontSize="11"
                                   Click="BtnOpenFile_Click" ToolTip="Mở tệp đề thi PDF, DOCX, TeX, TXT hoặc Ảnh (Ctrl + O)" />

                        <ui:Button x:Name="BtnPaste" Appearance="Secondary" 
                                   Icon="{ui:SymbolIcon ClipboardPaste24}"
                                   Content="Dán" Height="28" Padding="7,0" Margin="0,0,3,0" FontSize="11"
                                   Click="BtnPaste_Click" ToolTip="Dán văn bản hoặc hình ảnh từ Clipboard (Ctrl + V)" />

                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Height="28" Padding="5,0" Margin="0,0,3,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="RbOverwrite" Content="Ghi đè" IsChecked="True" GroupName="InsertMode" Margin="0,0,5,0" FontSize="10.5" VerticalAlignment="Center" ToolTip="Nạp tệp/dán sẽ ghi đè toàn bộ nội dung" />
                                <RadioButton x:Name="RbAppend" Content="Nối tiếp" GroupName="InsertMode" FontSize="10.5" VerticalAlignment="Center" ToolTip="Nạp tệp/dán sẽ nối thêm vào cuối nội dung hiện tại" />
                            </StackPanel>
                        </Border>

                        <ui:Button x:Name="BtnClear" Appearance="Danger" 
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Content="Xóa" Height="28" Padding="7,0" Margin="0,0,4,0" FontSize="11"
                                   Click="BtnClear_Click" ToolTip="Xóa trắng để nạp đề thi mới (Ctrl + Delete)" />

                        <Border Width="1" Height="18" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />

                        <!-- Bộ chọn Lớp & Môn & Khoảng trang PDF - Thu gọn vừa vặn với tên -->
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Height="28" Padding="5,0" Margin="0,0,3,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Lớp:" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,3,0" />
                                <ComboBox x:Name="CmbGrade" Width="58" Height="24" SelectedIndex="2" FontSize="10.5" Margin="0,0,4,0" 
                                          Padding="4,0,16,0" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="10" Padding="4,2" />
                                    <ComboBoxItem Content="11" Padding="4,2" />
                                    <ComboBoxItem Content="12" Padding="4,2" />
                                    <ComboBoxItem Content="9" Padding="4,2" />
                                    <ComboBoxItem Content="8" Padding="4,2" />
                                    <ComboBoxItem Content="7" Padding="4,2" />
                                    <ComboBoxItem Content="6" Padding="4,2" />
                                    <ComboBoxItem Content="Khác" Padding="4,2" />
                                </ComboBox>
                                <TextBlock Text="Môn:" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,3,0" />
                                <ComboBox x:Name="CmbSubject" Width="82" Height="24" SelectedIndex="0" FontSize="10.5" 
                                          Padding="4,0,16,0" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Toán" Padding="4,2" />
                                    <ComboBoxItem Content="Vật lí" Padding="4,2" />
                                    <ComboBoxItem Content="Hóa học" Padding="4,2" />
                                    <ComboBoxItem Content="Sinh học" Padding="4,2" />
                                    <ComboBoxItem Content="Ngữ văn" Padding="4,2" />
                                    <ComboBoxItem Content="Tiếng Anh" Padding="4,2" />
                                    <ComboBoxItem Content="Tin học" Padding="4,2" />
                                </ComboBox>
                                <TextBlock Text="Trang:" FontSize="10" VerticalAlignment="Center" Margin="5,0,2,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBox x:Name="TxtPageStart" Width="24" Height="22" Padding="1" FontSize="10" TextAlignment="Center" PlaceholderText="1" />
                                <TextBlock Text="-" FontSize="10" VerticalAlignment="Center" Margin="2,0" />
                                <ui:TextBox x:Name="TxtPageEnd" Width="28" Height="22" Padding="1" FontSize="10" TextAlignment="Center" PlaceholderText="Hết" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Cụm phải: 2 Nút hành động chính nổi bật -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="BtnConvert" Appearance="Success" 
                                   Icon="{ui:SymbolIcon Play24}"
                                   Content="Nhận diện câu hỏi" Height="28" Padding="10,0" Margin="0,0,4,0" FontWeight="SemiBold" FontSize="11"
                                   Click="BtnConvert_Click" ToolTip="Nhận diện câu hỏi &amp; Chuẩn hóa công thức (F5 hoặc Ctrl + Enter)" />
                        <ui:Button x:Name="BtnExportWord" Appearance="Primary" 
                                   Icon="{ui:SymbolIcon DocumentArrowRight24}"
                                   Content="Xuất file Word" Height="28" Padding="10,0" FontWeight="SemiBold" FontSize="11"
                                   Click="BtnExportWord_Click" ToolTip="Xuất tài liệu Word chuẩn A4 (Ctrl + S)" />
                        <ui:Button x:Name="BtnOpenInWord" Background="#1D4ED8" Foreground="White" 
                                   Icon="{ui:SymbolIcon Open24}" Visibility="Collapsed"
                                   Content="Mở Word" Height="28" Padding="10,0" Margin="0,0,4,0" FontWeight="SemiBold" FontSize="11"
                                   Click="BtnOpenInWord_Click" ToolTip="Mở ngay tài liệu đề thi chuẩn hóa trong Microsoft Word (Ctrl + Shift + O)" />
                        <ui:Button x:Name="BtnCancel" Appearance="Danger" 
                                   Icon="{ui:SymbolIcon Stop24}"
                                   Content="Hủy" Height="28" Padding="8,0" Visibility="Collapsed" Margin="4,0,0,0" FontSize="11"
                                   Click="BtnCancel_Click" ToolTip="Dừng tiến trình đang xử lý (Esc)" />
                    </StackPanel>
                </DockPanel>

                <!-- Hàng 2: Công cụ chuẩn hóa, Tiện ích LaTeX/NHCH & Chế độ xem trước -->
                <DockPanel Grid.Row="1" LastChildFill="False">
                    <!-- Cụm trái: Prompt AI, Định dạng, List sổ ra tùy chọn, Ngân hàng -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="BtnCopyPrompt" Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Copy24}"
                                   Content="Prompt AI" Height="26" Padding="6,0" Margin="0,0,3,0" FontSize="10.5"
                                   Click="BtnCopyPrompt_Click" ToolTip="Sao chép mẫu prompt chuẩn LaTeX ex_test cho ChatGPT, Gemini, Claude (Ctrl + Shift + P)" />
                        <ui:Button x:Name="BtnQuickBrace" Appearance="Transparent" Content="{}{Kẹp ${...}$}" Height="26" Padding="5,0" Margin="0,0,2,0" FontSize="10" Click="BtnQuickBrace_Click" ToolTip="Kẹp công thức toán học vào dạng ${...}$ (Ctrl + Shift + B)" />
                        <ui:Button x:Name="BtnFilterItem" Appearance="Transparent" Content="Lọc \item" Height="26" Padding="5,0" Margin="0,0,3,0" FontSize="10" Click="BtnFilterItem_Click" ToolTip="Lọc và tách các thẻ \item thành các ý a), b), c), d) (Ctrl + Shift + I)" />

                        <!-- List bấm để sổ ra tùy chọn gọn gàng (Bảo vệ |x|, Dựng bảng, Tháo $, Bảng '|', Dọn dòng, Lưu .tex) -->
                        <ui:Button x:Name="BtnOptions" Appearance="Secondary"
                                   Icon="{ui:SymbolIcon MoreHorizontal24}"
                                   Content="Tùy chọn" Height="26" Padding="6,0" Margin="0,0,3,0" FontSize="10.5"
                                   Click="BtnOptions_Click"
                                   ToolTip="Danh sách tùy chọn cấu hình &amp; công cụ (Bảo vệ |x|, Dựng bảng, Tháo $, Dọn dòng...)">
                            <ui:Button.ContextMenu>
                                <ContextMenu x:Name="CtxOptions">
                                    <MenuItem x:Name="MenuProtectAbs" Header="Bảo vệ |x|" IsCheckable="True" IsChecked="True"
                                              StaysOpenOnClick="True" Click="MenuProtectAbs_Click"
                                              ToolTip="Không biến dấu trị tuyệt đối |x| thành cột bảng" />
                                    <MenuItem x:Name="MenuAutoTable" Header="Dựng Bảng Word" IsCheckable="True" IsChecked="True"
                                              StaysOpenOnClick="True" Click="MenuAutoTable_Click"
                                              ToolTip="Tự động nhận diện và vẽ Table Grid trong Word" />
                                    <Separator />
                                    <MenuItem x:Name="MenuQuickUnbrace" Header="Tháo $ (Ctrl+Shift+U)" Click="BtnQuickUnbrace_Click"
                                              ToolTip="Chuyển ${...}$ trở lại dạng $...$" />
                                    <MenuItem x:Name="MenuQuickTable" Header="Chuẩn hóa Bảng '|'" Click="BtnQuickTable_Click"
                                              ToolTip="Chuẩn hóa các dòng bảng có ký tự '|'" />
                                    <MenuItem x:Name="MenuCleanWhitespace" Header="Dọn dòng trống" Click="BtnCleanWhitespace_Click"
                                              ToolTip="Xóa các dòng trống dư thừa" />
                                    <Separator />
                                    <MenuItem x:Name="MenuExportLatex" Header="Lưu .tex (Kèm preamble)" Click="BtnExportLatex_Click"
                                              ToolTip="Lưu tệp .tex cho toàn bộ câu hỏi (kèm preamble chuẩn)" />
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                        </ui:Button>

                        <Border Width="1" Height="16" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />

                        <ui:Button x:Name="BtnAddBank" Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Archive24}"
                                   Content="Thêm NHCH" Height="26" Padding="6,0" Margin="0,0,3,0" FontSize="10.5"
                                   Click="BtnAddBank_Click" ToolTip="Lưu câu hỏi vào Ngân hàng câu hỏi SQLite" />
                        <ui:Button x:Name="BtnCopyLatex" Appearance="Secondary"
                                   Content="Copy LaTeX" Height="26" Padding="6,0" Margin="0,0,4,0" FontSize="10.5"
                                   Click="BtnCopyLatex_Click" ToolTip="Sao chép mã LaTeX câu hỏi" />

                        <!-- Hidden proxy controls để giữ tương thích 100% với code-behind và phím tắt -->
                        <StackPanel Visibility="Collapsed">
                            <CheckBox x:Name="ChkProtectAbs" IsChecked="True" ToolTip="Không biến dấu trị tuyệt đối |x| thành cột bảng" />
                            <CheckBox x:Name="ChkAutoTable" IsChecked="True" ToolTip="Tự động nhận diện và vẽ Table Grid trong Word" />
                            <Button x:Name="BtnQuickUnbrace" Click="BtnQuickUnbrace_Click" ToolTip="Chuyển ${...}$ trở lại dạng $...$ (Ctrl + Shift + U)" />
                            <Button x:Name="BtnQuickTable" Click="BtnQuickTable_Click" ToolTip="Chuẩn hóa các dòng bảng có ký tự '|'" />
                            <Button x:Name="BtnCleanWhitespace" Click="BtnCleanWhitespace_Click" ToolTip="Xóa các dòng trống dư thừa" />
                            <Button x:Name="BtnExportLatex" Click="BtnExportLatex_Click" ToolTip="Lưu tệp .tex cho toàn bộ câu hỏi (kèm preamble chuẩn)" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Cụm phải: Bộ chọn chế độ xem trước dạng danh sách sổ xuống + Sao chép & Phóng to -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="CmbPreviewMode" Width="148" Height="26" SelectedIndex="0" FontSize="10.5" 
                                  Padding="6,0,16,0" Margin="0,0,4,0" VerticalContentAlignment="Center"
                                  SelectionChanged="CmbPreviewMode_SelectionChanged"
                                  ToolTip="Chọn chế độ xem trước (Trang in Word, Bảng câu hỏi, Mã nguồn)">
                            <ComboBoxItem x:Name="CbiPreviewWord" Content="Trang in Word" Padding="4,2" />
                            <ComboBoxItem x:Name="CbiPreviewQuestions" Content="Bảng câu hỏi (0)" Padding="4,2" />
                            <ComboBoxItem x:Name="CbiPreviewRaw" Content="Mã nguồn kẹp ${...}$" Padding="4,2" />
                        </ComboBox>

                        <!-- Hidden proxy radio buttons để bảo đảm 100% tương thích kiểm thử và luồng xử lý -->
                        <StackPanel Visibility="Collapsed">
                            <RadioButton x:Name="RbTabWordPreview" Content="Trang in Word" IsChecked="True" 
                                         GroupName="PreviewTabs" Checked="RbPreviewTab_Checked" />
                            <RadioButton x:Name="RbTabQuestionGrid" Content="Bảng câu hỏi (0)" 
                                         GroupName="PreviewTabs" Checked="RbPreviewTab_Checked" />
                            <RadioButton x:Name="RbTabRawCode" Content="Mã nguồn kẹp ${...}$" 
                                         GroupName="PreviewTabs" Checked="RbPreviewTab_Checked" />
                        </StackPanel>

                        <ui:Button x:Name="BtnCopyOutput" Appearance="Secondary" Icon="{ui:SymbolIcon Copy24}" 
                                   Content="Sao chép" Height="26" Padding="6,0" FontSize="10.5" Click="BtnCopyOutput_Click" Margin="0,0,3,0" 
                                   ToolTip="Sao chép nội dung kết quả xem trước vào Clipboard (Ctrl + C)" />
                        <ui:Button x:Name="BtnExpandPreview" Appearance="Secondary" Icon="{ui:SymbolIcon FullScreenMaximize24}" 
                                   Content="Mở rộng" Height="26" Padding="6,0" FontSize="10.5" Click="BtnExpandPreview_Click" 
                                   ToolTip="Mở khung xem trước độc lập toàn màn hình (Ctrl + Shift + F)" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </ui:Card>

        <!-- 3. Khung soạn thảo chia đôi (Split View: Đầu vào vs Khung Xem trước Kép - Co giãn thích ứng) -->
        <Grid x:Name="GridSplitContainer" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColSource" Width="*" MinWidth="260" />
                <ColumnDefinition x:Name="ColSplitter" Width="8" />
                <ColumnDefinition x:Name="ColPreview" Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Văn bản nguồn / PDF trích xuất / Ảnh đính kèm -->
            <ui:Card x:Name="CardSource" Grid.Column="0" Padding="10" AllowDrop="True" Drop="LeftCard_Drop" DragOver="LeftCard_DragOver">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DocumentText24" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="TxtInputHeaderTitle" Text="Nội dung nguồn" FontWeight="SemiBold" FontSize="12.5" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtInputStats" Text="0 từ | 0 dòng" FontSize="11" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ui:Button x:Name="BtnExpandPreviewFromSource" Appearance="Secondary"
                                       Icon="{ui:SymbolIcon ArrowRight24}"
                                       Content="Mở kết quả" Height="22" Padding="6,0" FontSize="10" Margin="0,0,4,0"
                                       Visibility="Collapsed" Click="BtnExpandPreviewFromSource_Click"
                                       ToolTip="Mở lại khung xem trước kết quả" />
                            <ui:Button x:Name="BtnCollapseSource" Appearance="Secondary"
                                       Icon="{ui:SymbolIcon ArrowLeft24}"
                                       Content="Đóng nguồn" Height="22" Padding="6,0" FontSize="10"
                                       ToolTip="Thu gọn nội dung nguồn để mở rộng khung xem trước Word to hết cỡ (F10 hoặc Ctrl+[)"
                                       Click="BtnCollapseSource_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Khung ảnh đính kèm (khi dán ảnh hoặc chọn ảnh OCR) -->
                    <Border x:Name="BorderAttachedImage" Grid.Row="1" Visibility="Collapsed"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="6" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Click vào để xem phóng to ảnh đề thi -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Cursor="Hand" Background="Transparent"
                                        MouseLeftButtonDown="AttachedImage_Click"
                                        ToolTip="Nhấp chuột để xem phóng to ảnh đề thi">
                                <Border CornerRadius="4" ClipToBounds="True" Margin="0,0,8,0">
                                    <Image x:Name="ImgAttachedPreview" Width="48" Height="48" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtAttachedImageInfo" Text="Ảnh đề thi đính kèm (Sẵn sàng AI Vision OCR)" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Text=" (Bấm để xem)" FontSize="10" Foreground="#0284C7" FontWeight="SemiBold" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="Bấm 'Bắt đầu Chuyển đổi' để AI nhận diện công thức ${...}$ và cấu trúc câu hỏi" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <ui:Button x:Name="BtnRemoveImage" Grid.Column="1" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss24}" Click="BtnRemoveImage_Click" ToolTip="Gỡ bỏ ảnh (Delete)" />
                        </Grid>
                    </Border>

                    <!-- Ô soạn thảo / Textbox nạp liệu -->
                    <ui:TextBox x:Name="TxtInput" Grid.Row="2"
                                AcceptsReturn="True" TextWrapping="Wrap"
                                VerticalContentAlignment="Top"
                                FontFamily="Consolas, 'Cascadia Code', 'Segoe UI', Arial" FontSize="12"
                                PlaceholderText="Kéo thả tệp PDF vào đây, hoặc dán nội dung câu hỏi (Ctrl+V)..."
                                TextChanged="TxtInput_TextChanged" />

                    <!-- Thanh tiến độ khi đang đọc PDF hoặc chạy AI -->
                    <ProgressBar x:Name="ProgExtraction" Grid.Row="3" Height="4" Margin="0,6,0,0" 
                                 Visibility="Collapsed" IsIndeterminate="True" />

                    <!-- Thanh thống kê nguồn chi tiết (Chuẩn MEA v5.0) -->
                    <Border Grid.Row="4" Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                            CornerRadius="4" Padding="6,3" Margin="0,4,0,0">
                        <TextBlock x:Name="TxtSourceStats" 
                                   Text="0 từ | 0 dòng | 0 công thức | 0 bảng | Phân loại: 0 NB, 0 TH, 0 VD, 0 VDC" 
                                   FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </ui:Card>

            <GridSplitter x:Name="SplitterConvert" Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Cột phải: Xem trước Kép (Dual View: Trang In Word A4 vs Mã nguồn ${...}$) -->
            <ui:Card x:Name="CardPreview" Grid.Column="2" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header Cột phải: Đồng bộ trực quan, hoàn toàn giải phóng các nút bấm -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Nút Mở nguồn khi nguồn bị thu gọn (giống TikzView) -->
                            <ui:Button x:Name="BtnExpandSource" Background="#0D9488" Foreground="White" FontWeight="Bold"
                                       Icon="{ui:SymbolIcon ArrowRight24}"
                                       Content="Mở nguồn" Height="24" Padding="8,0" FontSize="10" Margin="0,0,6,2"
                                       Visibility="Collapsed"
                                       ToolTip="Mở lại khung soạn thảo nội dung nguồn (F10 hoặc Ctrl+[)"
                                       Click="BtnExpandSource_Click" />

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,2">
                                <ui:SymbolIcon Symbol="DocumentCheckmark24" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Kết quả xem trước" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Cụm 3 nút chuyển đổi: 1:1 / Chỉ kết quả / Chỉ nguồn (chuẩn giống bên TikzView) -->
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Height="24" Padding="2,0" Margin="0,0,6,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button x:Name="BtnModeSplit" Appearance="Transparent" Content="1:1" Height="20" Padding="5,0" FontSize="9.5" FontWeight="SemiBold"
                                               ToolTip="Chế độ chia đôi (Nguồn 50% : Xem trước 50%)" Click="BtnModeSplit_Click" />
                                    <ui:Button x:Name="BtnModePreviewOnly" Appearance="Transparent" Content="Chỉ kết quả" Height="20" Padding="5,0" FontSize="9.5" FontWeight="SemiBold"
                                               ToolTip="Chế độ chỉ xem kết quả Word to hết cỡ (Thu gọn nguồn)" Click="BtnModePreviewOnly_Click" />
                                    <ui:Button x:Name="BtnModeSourceOnly" Appearance="Transparent" Content="Chỉ nguồn" Height="20" Padding="5,0" FontSize="9.5" FontWeight="SemiBold"
                                               ToolTip="Chế độ chỉ soạn thảo nội dung nguồn (Thu gọn kết quả)" Click="BtnModeSourceOnly_Click" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPreviewSubtitle" Text="Mô phỏng chuẩn Word A4 (Sẵn sàng xuất Word)" FontSize="11" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Vùng hiển thị xem trước (3 chế độ) -->
                    <Grid Grid.Row="1">
                        <!-- Chế độ 1: Mô phỏng Trang in Word A4 (Rich Page View) -->
                        <Border x:Name="BorderWordPageContainer" Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Thanh công cụ tinh chỉnh hiển thị Word Preview thời gian thực (WrapPanel tự xuống dòng chống tràn) -->
                                <Border Grid.Row="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                                        Padding="8,4" CornerRadius="6,6,0,0">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,8,2">
                                            <TextBlock Text="Cỡ chữ:" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,3,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ComboBox x:Name="CmbWordFontSize" Width="68" Height="24" SelectedIndex="1" FontSize="10"
                                                      Padding="4,0,16,0" VerticalContentAlignment="Center"
                                                      SelectionChanged="WordPreviewSetting_Changed"
                                                      ToolTip="Cỡ chữ văn bản chuẩn Word (11pt, 12pt, 13pt)">
                                                <ComboBoxItem Content="11 pt" Tag="11" Padding="4,2" />
                                                <ComboBoxItem Content="12 pt" Tag="12" Padding="4,2" />
                                                <ComboBoxItem Content="13 pt" Tag="13" Padding="4,2" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,8,2">
                                            <TextBlock Text="Dãn dòng:" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,3,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ComboBox x:Name="CmbWordLineSpacing" Width="64" Height="24" SelectedIndex="1" FontSize="10"
                                                      Padding="4,0,16,0" VerticalContentAlignment="Center"
                                                      SelectionChanged="WordPreviewSetting_Changed"
                                                      ToolTip="Khoảng cách dòng chuẩn sư phạm (1.0, 1.15, 1.5)">
                                                <ComboBoxItem Content="1.0" Tag="1.0" Padding="4,2" />
                                                <ComboBoxItem Content="1.15" Tag="1.15" Padding="4,2" />
                                                <ComboBoxItem Content="1.5" Tag="1.5" Padding="4,2" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,8,2">
                                            <TextBlock Text="Dàn đáp án:" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,3,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ComboBox x:Name="CmbWordChoiceLayout" Width="82" Height="24" SelectedIndex="0" FontSize="10"
                                                      Padding="4,0,16,0" VerticalContentAlignment="Center"
                                                      SelectionChanged="WordPreviewSetting_Changed"
                                                      ToolTip="Cách phân bổ các phương án A, B, C, D trên dòng">
                                                <ComboBoxItem Content="Tự động" Tag="auto" Padding="4,2" />
                                                <ComboBoxItem Content="4 Cột" Tag="4col" Padding="4,2" />
                                                <ComboBoxItem Content="2 Cột" Tag="2col" Padding="4,2" />
                                                <ComboBoxItem Content="1 Cột" Tag="1col" Padding="4,2" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                                            <CheckBox x:Name="ChkWordShowSolutions" Content="Hiện lời giải" IsChecked="True" FontSize="10.5"
                                                      Margin="0,0,8,0" VerticalAlignment="Center"
                                                      Click="WordPreviewSetting_Changed"
                                                      ToolTip="Bật/tắt hiển thị phần lời giải chi tiết và hướng dẫn giải" />
                                            <CheckBox x:Name="ChkWordShowAnswerSheet" Content="Bảng đáp án" IsChecked="True" FontSize="10.5"
                                                      VerticalAlignment="Center"
                                                      Click="WordPreviewSetting_Changed"
                                                      ToolTip="Bật/tắt hiển thị bảng phiếu soi đáp án nhanh" />
                                        </StackPanel>
                                    </WrapPanel>
                                </Border>

                                <ScrollViewer Grid.Row="1" x:Name="ScrollWordPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <Border x:Name="BorderWordA4Page" Margin="12" Background="#FFFFFF" TextElement.Foreground="#0F172A" CornerRadius="4" Padding="20" MaxWidth="680" HorizontalAlignment="Stretch">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.10" ShadowDepth="2" />
                                        </Border.Effect>
                                    <StackPanel x:Name="PanelRichDocContainer">
                                        <!-- Header tài liệu mô phỏng Word chuẩn THPT (kế thừa m:\LOP\KT15P-1) -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="SỞ/PHÒNG GD&amp;ĐT" FontSize="10" FontWeight="Bold" FontFamily="Times New Roman" HorizontalAlignment="Center" Foreground="#0F172A" />
                                                <TextBlock Text="ĐỀ KIỂM TRA" FontSize="10" FontWeight="Bold" FontFamily="Times New Roman" HorizontalAlignment="Center" Foreground="#0F172A" />
                                                <TextBlock Text="(Đề thi gồm 20 câu)" FontSize="9" FontStyle="Italic" FontFamily="Times New Roman" HorizontalAlignment="Center" Foreground="#475569" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="ĐỀ THI MÔN TOÁN - LỚP 12" FontSize="10" FontWeight="Bold" FontFamily="Times New Roman" HorizontalAlignment="Center" Foreground="#0F172A" />
                                                <TextBlock Text="Môn thi: TOÁN" FontSize="10" FontWeight="Bold" FontFamily="Times New Roman" HorizontalAlignment="Center" Foreground="#0F172A" />
                                                <TextBlock Text="Thời gian làm bài: 90 phút, không kể thời gian phát đề" FontSize="9" FontStyle="Italic" FontFamily="Times New Roman" HorizontalAlignment="Center" Foreground="#475569" />
                                                <TextBlock Text="Lớp: 12  Năm học: 2025-2026" FontSize="9" FontFamily="Times New Roman" HorizontalAlignment="Center" Foreground="#475569" />
                                            </StackPanel>
                                        </Grid>
                                        <!-- Dòng thông tin thí sinh phẳng không viền hộp -->
                                        <TextBlock Text="Họ và tên: …………………………………………..   Số báo danh: ………………   Mã đề: 101" FontFamily="Times New Roman" FontSize="10.5" Margin="0,0,0,10" Foreground="#0F172A" />
                                        <Separator Margin="0,0,0,10" Background="#CBD5E1" />

                                        <!-- Nội dung được dựng trực tiếp (Đoạn văn + Bảng biểu Table Grid) -->
                                        <StackPanel x:Name="PanelDocContent" />
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Chế độ 2: Bảng danh sách câu hỏi DataGrid (Khắc phục hoàn toàn che chữ và lỗi nền tối) -->
                        <Border x:Name="BorderQuestionsContainer" Visibility="Collapsed" 
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                CornerRadius="6" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="140" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="175" MinHeight="90" MaxHeight="320" />
                                </Grid.RowDefinitions>

                                <!-- Header bảng câu hỏi tích hợp bộ lọc CmbQTypeFilter (Width=155) -->
                                <Border Grid.Row="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="10,6" CornerRadius="6,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Table24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0" />
                                            <TextBlock x:Name="TxtQuestionsHeader" Text="Danh sách câu hỏi đã nhận diện: 0 câu" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtQuestionsBreakdown" Text=" (TN: 0 | DS: 0 | TLN: 0 | TL: 0)" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Lọc dạng:" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ComboBox x:Name="CmbQTypeFilter" Width="155" Height="28" SelectedIndex="0" FontSize="11" 
                                                      Padding="8,0,24,0" VerticalContentAlignment="Center"
                                                      SelectionChanged="CmbQTypeFilter_SelectionChanged"
                                                      ToolTip="Lọc hiển thị danh sách theo dạng câu hỏi (TN, DS, TLN, TL)">
                                                <ComboBoxItem Content="Tất cả dạng câu" Tag="ALL" Padding="8,4" />
                                                <ComboBoxItem Content="Trắc nghiệm (TN)" Tag="TN" Padding="8,4" />
                                                <ComboBoxItem Content="Đúng / Sai (DS)" Tag="DS" Padding="8,4" />
                                                <ComboBoxItem Content="Trả lời ngắn (TLN)" Tag="TLN" Padding="8,4" />
                                                <ComboBoxItem Content="Tự luận (TL)" Tag="TL" Padding="8,4" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- DataGrid hiển thị bảng câu hỏi chuẩn không che chữ, hỗ trợ cuộn ngang/dọc và kéo thả độ rộng cột -->
                                <DataGrid x:Name="DgQuestions" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          Background="Transparent" RowBackground="Transparent"
                                          BorderThickness="0" SelectionMode="Single"
                                          FontFamily="Segoe UI" FontSize="11"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          CanUserResizeColumns="True"
                                          CanUserSortColumns="True"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          SelectionChanged="DgQuestions_SelectionChanged">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Padding" Value="6,4,6,4" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Padding" Value="6,4,6,4" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Padding" Value="4,2" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Môn/Lớp" Binding="{Binding SubjectGrade}" Width="85">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="4,2" />
                                                    <Setter Property="ToolTip" Value="{Binding SubjectGrade}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Loại" Binding="{Binding TypeShort}" Width="65">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="4,2" />
                                                    <Setter Property="ToolTip" Value="{Binding TypeShort}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Mức độ" Binding="{Binding CognitiveLevel}" Width="95">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="4,2" />
                                                    <Setter Property="ToolTip" Value="{Binding CognitiveLevel}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Chủ đề" Binding="{Binding Topic}" Width="120">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="4,2" />
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                    <Setter Property="ToolTip" Value="{Binding Topic}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Đáp án" Binding="{Binding CorrectAnswer}" Width="65">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Foreground" Value="#10B981" />
                                                    <Setter Property="Padding" Value="4,2" />
                                                    <Setter Property="ToolTip" Value="{Binding CorrectAnswer}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Nội dung câu hỏi" Binding="{Binding ContentPreview}" Width="2*" MinWidth="240">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="4,2" />
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                    <Setter Property="ToolTip" Value="{Binding ContentPreview}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Lời giải" Binding="{Binding ExplanationPreview}" Width="1.5*" MinWidth="180">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="4,2" />
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                    <Setter Property="ToolTip" Value="{Binding ExplanationPreview}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Thanh chia co giãn chiều cao chi tiết câu hỏi -->
                                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" 
                                              Background="{DynamicResource CardStrokeColorDefaultBrush}" Cursor="SizeNS" />

                                <!-- Khung xem chi tiết câu hỏi & Lời giải được chọn -->
                                <Border x:Name="BorderQuestionDetail" Grid.Row="3" Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="10,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="DocumentSearch24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0" />
                                                <TextBlock x:Name="TxtDetailTitle" Text="Chi tiết câu hỏi được chọn" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                <Border x:Name="BadgeDetailType" Background="#1A0284C7" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtBadgeDetailType" Text="Trắc nghiệm" FontSize="10" Foreground="#0284C7" FontWeight="SemiBold" />
                                                </Border>
                                                <Border x:Name="BadgeDetailLevel" Background="#1A10B981" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtBadgeDetailLevel" Text="Thông hiểu" FontSize="10" Foreground="#10B981" FontWeight="SemiBold" />
                                                </Border>
                                                <Border x:Name="BadgeDetailAns" Background="#1AF59E0B" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtBadgeDetailAns" Text="Đ/Á: A" FontSize="10" Foreground="#F59E0B" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button x:Name="BtnCopyDetailLatex" Appearance="Transparent" Icon="{ui:SymbolIcon Copy24}" Content="Copy câu này" 
                                                           Padding="6,2" FontSize="10" Click="BtnCopyDetailLatex_Click" ToolTip="Sao chép nội dung &amp; lời giải của câu hỏi đang chọn" />
                                            </StackPanel>
                                        </Grid>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="PanelDetailContent">
                                                <TextBlock x:Name="TxtDetailEmptyHint" Text="💡 Bấm chọn một câu hỏi trong danh sách ở trên để xem chi tiết đầy đủ nội dung, 4 phương án lựa chọn và lời giải." 
                                                           FontStyle="Italic" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="4,8" />

                                                <TextBlock x:Name="TxtDetailQuestionBody" TextWrapping="Wrap" FontSize="11.5" FontFamily="Times New Roman, Segoe UI" 
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" LineHeight="18" Margin="0,0,0,6" Visibility="Collapsed" />

                                                <StackPanel x:Name="PanelDetailOptions" Margin="12,0,0,8" Visibility="Collapsed" />

                                                <Border x:Name="BorderDetailExplanation" Background="{DynamicResource ControlFillColorDefaultBrush}" 
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,4,0,4" Visibility="Collapsed">
                                                    <StackPanel>
                                                        <TextBlock Text="Lời giải chi tiết:" FontWeight="SemiBold" FontSize="11" Foreground="#0284C7" Margin="0,0,0,3" />
                                                        <TextBlock x:Name="TxtDetailExplanation" TextWrapping="Wrap" FontSize="11" FontFamily="Times New Roman, Segoe UI" 
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" LineHeight="17" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Chế độ 3: Mã nguồn TextBox thô (ẩn/hiện theo Tab) -->
                        <ui:TextBox x:Name="TxtOutput" Visibility="Collapsed"
                                    IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                    VerticalContentAlignment="Top"
                                    FontFamily="Consolas, 'Cascadia Code', 'Segoe UI', Arial" FontSize="12"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}" />
                    </Grid>

                    <!-- Thống kê kết quả bên dưới -->
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <TextBlock x:Name="TxtOutputStats" Text="Chưa có kết quả" 
                                   FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtFormulaCount" Text="0 công thức ${...}$" FontSize="10.5" Foreground="#0284C7" Margin="0,0,10,0" />
                            <TextBlock x:Name="TxtTableCount" Text="0 bảng Table Grid" FontSize="10.5" Foreground="#10B981" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- 4. Băng thông báo InfoBar -->
        <ui:InfoBar x:Name="InfoNotification" Grid.Row="3" Margin="0,8,0,0"
                    IsOpen="False" Severity="Success"
                    Title="Chuyển đổi hoàn tất" 
                    Message="Đã chuẩn hóa công thức sang dạng ${...}$ và sẵn sàng xuất file Word." />
    </Grid>
</UserControl>
