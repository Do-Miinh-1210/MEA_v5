<Window x:Class="MatrixExamAI.Desktop.Views.TikzShapeBuilderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Công cụ Dựng hình Trực quan TikZ (2D, 3D &amp; tkz-tab)"
        Height="540" Width="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="6" Background="#8B5CF6" Margin="0,0,8,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Shapes24" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Công cụ Dựng hình Trực quan TikZ &amp; Bảng biến thiên (tkz-tab)" FontSize="15" FontWeight="Bold" />
                    <TextBlock Text="Chọn loại hình học hoặc bảng biến thiên, điều chỉnh thông số → Tự động sinh mã LaTeX TikZ chuẩn" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Body: 2 Columns Split -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Chọn danh mục & Thông số -->
            <ui:Card Grid.Column="0" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="1. Danh mục hình vẽ:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbCategory" Height="28" SelectedIndex="0" FontSize="11" Margin="0,0,0,10"
                                  SelectionChanged="CmbCategory_SelectionChanged">
                            <ComboBoxItem Content="Hình học phẳng 2D" Tag="2D" />
                            <ComboBoxItem Content="Hình không gian 3D" Tag="3D" />
                            <ComboBoxItem Content="Bảng biến thiên &amp; Xét dấu (tkz-tab)" Tag="TAB" />
                            <ComboBoxItem Content="Đồ thị hàm số (pgfplots)" Tag="GRAPH" />
                        </ComboBox>

                        <TextBlock Text="2. Loại hình cụ thể:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbShapeType" Height="28" SelectedIndex="0" FontSize="11" Margin="0,0,0,12"
                                  SelectionChanged="CmbShapeType_SelectionChanged" />

                        <Separator Margin="0,0,0,10" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                        <!-- Vùng thông số động -->
                        <TextBlock Text="3. Thiết lập thông số:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                        
                        <!-- Panel tham số 1 -->
                        <Grid x:Name="GridParam1" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblParam1" Text="Cạnh a / Đáy:" FontSize="10.5" VerticalAlignment="Center" />
                            <ui:TextBox x:Name="TxtParam1" Grid.Column="1" Height="26" Text="4" FontSize="11" Padding="4,2" TextChanged="Param_TextChanged" />
                        </Grid>

                        <!-- Panel tham số 2 -->
                        <Grid x:Name="GridParam2" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblParam2" Text="Cạnh b / Cao:" FontSize="10.5" VerticalAlignment="Center" />
                            <ui:TextBox x:Name="TxtParam2" Grid.Column="1" Height="26" Text="3" FontSize="11" Padding="4,2" TextChanged="Param_TextChanged" />
                        </Grid>

                        <!-- Panel tham số 3 -->
                        <Grid x:Name="GridParam3" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblParam3" Text="Chiều cao h:" FontSize="10.5" VerticalAlignment="Center" />
                            <ui:TextBox x:Name="TxtParam3" Grid.Column="1" Height="26" Text="4" FontSize="11" Padding="4,2" TextChanged="Param_TextChanged" />
                        </Grid>

                        <!-- Panel tham số 4 (Đỉnh hoặc Nhãn) -->
                        <Grid x:Name="GridParam4" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblParam4" Text="Tên các đỉnh:" FontSize="10.5" VerticalAlignment="Center" />
                            <ui:TextBox x:Name="TxtParam4" Grid.Column="1" Height="26" Text="A, B, C, D" FontSize="11" Padding="4,2" TextChanged="Param_TextChanged" />
                        </Grid>

                        <!-- Tùy chọn checkbox (nếu có) -->
                        <CheckBox x:Name="ChkOption" Content="Hiển thị góc vuông / đường phụ" Margin="0,6,0,0" FontSize="10.5" IsChecked="True" Checked="ChkOption_Changed" Unchecked="ChkOption_Changed" />
                    </StackPanel>
                </ScrollViewer>
            </ui:Card>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Cột phải: Xem trước mã nguồn sinh ra -->
            <ui:Card Grid.Column="2" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Code24" FontSize="14" Foreground="#8B5CF6" Margin="0,0,6,0" />
                            <TextBlock Text="Mã nguồn LaTeX TikZ sinh tự động" FontWeight="SemiBold" FontSize="11.5" />
                        </StackPanel>
                    </Grid>

                    <ui:TextBox x:Name="TxtResultCode" Grid.Row="1"
                                AcceptsReturn="True" TextWrapping="Wrap"
                                VerticalContentAlignment="Top"
                                FontFamily="Consolas, 'Cascadia Code', monospace" FontSize="11"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}" />
                </Grid>
            </ui:Card>
        </Grid>

        <!-- Footer Buttons -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="* Mã nguồn có thể chỉnh sửa tự do trước khi chèn vào bài vẽ" FontSize="10" FontStyle="Italic" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="BtnCopyCode" Appearance="Secondary" Icon="{ui:SymbolIcon Copy24}"
                           Content="Sao chép mã" Height="28" Padding="10,0" FontSize="11" Margin="0,0,6,0"
                           Click="BtnCopyCode_Click" ToolTip="Sao chép mã vào Clipboard" />
                <ui:Button x:Name="BtnInsert" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}"
                           Content="Chèn vào Trình vẽ" Height="28" Padding="12,0" FontSize="11" Margin="0,0,6,0" FontWeight="SemiBold"
                           Click="BtnInsert_Click" ToolTip="Chèn mã TikZ vào ô soạn thảo của TikzView" />
                <ui:Button x:Name="BtnCancel" Appearance="Secondary"
                           Content="Đóng" Height="28" Padding="10,0" FontSize="11"
                           Click="BtnCancel_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
