<Window x:Class="MatrixExamAI.Desktop.Views.TikzShapeBuilderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Công cụ vẽ hình — Chọn loại &amp; nhập thông số"
        Height="620" Width="980"
        MinHeight="540" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="6" Background="#0284C7" Margin="0,0,10,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Shapes24" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Công cụ vẽ hình trực quan" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Chọn loại hình học, đồ thị hoặc biểu đồ bên trái → Nhập thông số → Tự động tạo code TikZ chuẩn" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Body: Cột trái (TreeView 300px) & Cột phải (Thông số trên + Mã sinh ra dưới) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="220" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <!-- Cột trái: TreeView Chọn loại hình -->
            <ui:Card Grid.Column="0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Chọn loại hình:" FontWeight="SemiBold" FontSize="12" Margin="4,2,4,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <TreeView x:Name="TreeShapeCategories" Grid.Row="1" BorderThickness="0" Background="Transparent"
                              SelectedItemChanged="TreeShapeCategories_SelectedItemChanged">
                        <!-- 1. Hình phẳng -->
                        <TreeViewItem Header="📐 Hình phẳng" IsExpanded="True" FontSize="11.5" FontWeight="SemiBold">
                            <TreeViewItem Header="Tam giác thường" Tag="tri_general" FontWeight="Normal" />
                            <TreeViewItem Header="Tam giác vuông" Tag="tri_right" FontWeight="Normal" />
                            <TreeViewItem Header="Tam giác đều" Tag="tri_equi" FontWeight="Normal" />
                            <TreeViewItem Header="Tam giác cân" Tag="tri_iso" FontWeight="Normal" />
                            <TreeViewItem Header="Hình vuông" Tag="square" FontWeight="Normal" />
                            <TreeViewItem Header="Hình chữ nhật" Tag="rect" FontWeight="Normal" />
                            <TreeViewItem Header="Hình bình hành" Tag="parallelogram" FontWeight="Normal" />
                            <TreeViewItem Header="Hình thang" Tag="trapezoid" FontWeight="Normal" />
                            <TreeViewItem Header="Đường tròn" Tag="circle" FontWeight="Normal" />
                            <TreeViewItem Header="Elip" Tag="ellipse" FontWeight="Normal" />
                            <TreeViewItem Header="Đoạn thẳng" Tag="segment" FontWeight="Normal" />
                        </TreeViewItem>

                        <!-- 2. Hình không gian -->
                        <TreeViewItem Header="📦 Hình không gian" IsExpanded="True" FontSize="11.5" FontWeight="SemiBold">
                            <TreeViewItem Header="Hình chóp S.ABCD" Tag="pyramid" FontWeight="Normal" />
                            <TreeViewItem Header="Hình chóp tam giác S.ABC" Tag="tetrahedron" FontWeight="Normal" />
                            <TreeViewItem Header="Hình hộp chữ nhật" Tag="cuboid" FontWeight="Normal" />
                            <TreeViewItem Header="Hình trụ" Tag="cylinder" FontWeight="Normal" />
                            <TreeViewItem Header="Hình nón" Tag="cone" FontWeight="Normal" />
                            <TreeViewItem Header="Hình cầu" Tag="sphere" FontWeight="Normal" />
                        </TreeViewItem>

                        <!-- 3. Đồ thị hàm số -->
                        <TreeViewItem Header="📈 Đồ thị hàm số" IsExpanded="True" FontSize="11.5" FontWeight="SemiBold">
                            <TreeViewItem Header="Hàm bậc 2 (ax² + bx + c)" Tag="graph_quad" FontWeight="Normal" />
                            <TreeViewItem Header="Hàm bậc 3 (ax³ + bx² + cx + d)" Tag="graph_cubic" FontWeight="Normal" />
                            <TreeViewItem Header="Hàm bậc 4 trùng phương" Tag="graph_quartic" FontWeight="Normal" />
                            <TreeViewItem Header="Hàm lượng giác (sin/cos)" Tag="graph_trig" FontWeight="Normal" />
                            <TreeViewItem Header="Hàm phân thức (ax+b)/(cx+d)" Tag="graph_rational" FontWeight="Normal" />
                        </TreeViewItem>

                        <!-- 4. Biểu đồ -->
                        <TreeViewItem Header="📊 Biểu đồ" IsExpanded="True" FontSize="11.5" FontWeight="SemiBold">
                            <TreeViewItem Header="Biểu đồ cột" Tag="chart_bar" FontWeight="Normal" />
                            <TreeViewItem Header="Biểu đồ tròn" Tag="chart_pie" FontWeight="Normal" />
                            <TreeViewItem Header="Biểu đồ đường" Tag="chart_line" FontWeight="Normal" />
                            <TreeViewItem Header="Biểu đồ miền" Tag="chart_area" FontWeight="Normal" />
                        </TreeViewItem>

                        <!-- 5. Bảng biến thiên tkz-tab -->
                        <TreeViewItem Header="📋 Bảng biến thiên (tkz-tab)" IsExpanded="False" FontSize="11.5" FontWeight="SemiBold">
                            <TreeViewItem Header="Bảng biến thiên bậc 3 (2 cực trị)" Tag="tab_cubic" FontWeight="Normal" />
                            <TreeViewItem Header="Bảng biến thiên bậc 4 trùng phương" Tag="tab_quartic" FontWeight="Normal" />
                            <TreeViewItem Header="Bảng biến thiên phân thức hữu tỉ" Tag="tab_rational" FontWeight="Normal" />
                            <TreeViewItem Header="Bảng xét dấu tam thức bậc hai" Tag="tab_sign_quad" FontWeight="Normal" />
                        </TreeViewItem>
                    </TreeView>
                </Grid>
            </ui:Card>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Cột phải: Thông số ở trên & Mã sinh ra ở dưới -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="180" MinHeight="130" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" MinHeight="160" />
                </Grid.RowDefinitions>

                <!-- Panel Thông số -->
                <ui:Card Grid.Row="0" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Thông số" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PanelParamsContainer">
                                <!-- Hàng thông số 1 -->
                                <Grid x:Name="GridParam1" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblParam1" Text="Cạnh a / Đáy:" FontSize="11" VerticalAlignment="Center" />
                                    <ui:TextBox x:Name="TxtParam1" Grid.Column="1" Height="26" Text="4" FontSize="11" TextChanged="Param_TextChanged" />
                                </Grid>

                                <!-- Hàng thông số 2 -->
                                <Grid x:Name="GridParam2" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblParam2" Text="Cạnh b / Chiều cao:" FontSize="11" VerticalAlignment="Center" />
                                    <ui:TextBox x:Name="TxtParam2" Grid.Column="1" Height="26" Text="3" FontSize="11" TextChanged="Param_TextChanged" />
                                </Grid>

                                <!-- Hàng thông số 3 -->
                                <Grid x:Name="GridParam3" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblParam3" Text="Hệ số / Bán kính:" FontSize="11" VerticalAlignment="Center" />
                                    <ui:TextBox x:Name="TxtParam3" Grid.Column="1" Height="26" Text="2" FontSize="11" TextChanged="Param_TextChanged" />
                                </Grid>

                                <!-- Hàng thông số 4 -->
                                <Grid x:Name="GridParam4" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblParam4" Text="Tên các đỉnh / Nhãn:" FontSize="11" VerticalAlignment="Center" />
                                    <ui:TextBox x:Name="TxtParam4" Grid.Column="1" Height="26" Text="A, B, C, D" FontSize="11" TextChanged="Param_TextChanged" />
                                </Grid>

                                <!-- Tùy chọn checkbox -->
                                <CheckBox x:Name="ChkOption" Content="Hiển thị góc vuông / đường nét đứt phụ" FontSize="11" IsChecked="True" Checked="ChkOption_Changed" Unchecked="ChkOption_Changed" Margin="0,4,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </ui:Card>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- Panel Mã TikZ sinh ra -->
                <ui:Card Grid.Row="2" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Mã TikZ sinh ra" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <ui:TextBox x:Name="TxtResultCode" Grid.Row="1"
                                    AcceptsReturn="True" TextWrapping="Wrap"
                                    VerticalContentAlignment="Top"
                                    FontFamily="Consolas, 'Cascadia Code', monospace" FontSize="11.5"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}" />
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>

        <!-- Footer Buttons: [Xem trước code], [Hủy], [Chèn vào Editor] -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="* Mã nguồn TikZ tương thích 100% với TeXLive, MiKTeX và Overleaf" FontSize="10.5" FontStyle="Italic" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="BtnPreviewCode" Background="#8B5CF6" Foreground="White" FontWeight="SemiBold"
                           Icon="{ui:SymbolIcon Code24}" Content="Xem trước code" Height="30" Padding="12,0" FontSize="11" Margin="0,0,8,0"
                           Click="BtnPreviewCode_Click" ToolTip="Cập nhật và định dạng lại mã TikZ" />
                <ui:Button x:Name="BtnCancel" Appearance="Secondary"
                           Content="Hủy" Height="30" Padding="14,0" FontSize="11" Margin="0,0,8,0"
                           Click="BtnCancel_Click" />
                <ui:Button x:Name="BtnInsert" Background="#16A34A" Foreground="White" FontWeight="Bold"
                           Icon="{ui:SymbolIcon Checkmark24}" Content="Chèn vào Editor" Height="30" Padding="16,0" FontSize="11.5"
                           Click="BtnInsert_Click" ToolTip="Chèn mã TikZ vào ô soạn thảo của TikzView" />
            </StackPanel>
        </DockPanel>

        <!-- Hidden ComboBoxes for backward compatibility and test automation -->
        <StackPanel Visibility="Collapsed">
            <ComboBox x:Name="CmbCategory" SelectionChanged="CmbCategory_SelectionChanged">
                <ComboBoxItem Content="Hình học phẳng (2D)" />
                <ComboBoxItem Content="Hình không gian (3D)" />
                <ComboBoxItem Content="Bảng biến thiên (tkz-tab)" />
                <ComboBoxItem Content="Đồ thị hàm số (axis)" />
                <ComboBoxItem Content="Biểu đồ thống kê" />
            </ComboBox>
            <ComboBox x:Name="CmbShapeType" SelectionChanged="CmbShapeType_SelectionChanged" />
        </StackPanel>
    </Grid>
</Window>
