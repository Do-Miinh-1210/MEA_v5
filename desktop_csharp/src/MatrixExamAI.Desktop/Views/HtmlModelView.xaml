<UserControl x:Class="MatrixExamAI.Desktop.Views.HtmlModelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Focusable="True"
             PreviewKeyDown="HtmlModelView_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="AccentVibrantButtonStyle" TargetType="ui:Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter x:Name="IconPresenter"
                                                  Content="{TemplateBinding Icon}"
                                                  Margin="0,0,5,0"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="White" />
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="White" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.88" />
                                <Setter Property="Cursor" Value="Hand" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề Phân hệ (Sleek & Compact) -->
        <Grid Grid.Row="0" Margin="0,0,0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="6" Background="#0D9488" Margin="0,0,8,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Cube24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Mô hình Toán học &amp; Khoa học HTML 3D" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Border Background="#1A0D9488" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Three.js • KaTeX • Tailwind" FontSize="9.5" Foreground="#0D9488" FontWeight="SemiBold" />
                </Border>
            </StackPanel>

            <!-- Trạng thái WebView2 Runtime -->
            <Border Grid.Column="1" Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon x:Name="IconWebStatus" Symbol="CheckmarkCircle24" FontSize="13" Foreground="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtWebStatus" Text="WebView2: Sẵn sàng" FontSize="11" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Thanh công cụ phân loại, thư viện mẫu & thao tác nhanh (2 Hàng công thái học) -->
        <ui:Card Grid.Row="1" Margin="0,0,0,4" Padding="8,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Hàng 1: Ô Nhập Trực tiếp Đề bài / Mô tả Bài toán (Thoáng đãng, rộng rãi) -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ComboBoxes ẩn để bảo toàn code-behind / category fallback -->
                    <ComboBox x:Name="CmbCategory" Visibility="Collapsed" SelectionChanged="CmbCategory_SelectionChanged" />
                    <ComboBox x:Name="CmbTemplateItem" Visibility="Collapsed" SelectionChanged="CmbTemplateItem_SelectionChanged" />

                    <ui:TextBox x:Name="TxtPrompt" Height="34" FontSize="11" Padding="10,3"
                                VerticalContentAlignment="Center"
                                PlaceholderText="Nhập đề bài toán học / KHTN hoặc mô tả mô hình mô phỏng 3D cần tạo (Nhấn Enter hoặc bấm 'AI tạo')..."
                                ToolTip="Nhập đề bài hoặc mô tả để AI tạo mô hình tương tác (Enter hoặc bấm 'AI tạo')"
                                KeyDown="TxtPrompt_KeyDown" />
                </Grid>

                <!-- Hàng 2: Bộ nút hành động màu sắc trực quan (Công thái học, 1 Nút - 1 Icon) -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- AI Tạo: Màu Tím Violet #7C3AED -->
                    <ui:Button x:Name="BtnAiGenerate" Style="{StaticResource AccentVibrantButtonStyle}"
                               Background="#7C3AED" Foreground="White" FontWeight="Bold"
                               Icon="{ui:SymbolIcon Sparkle24}" Content="AI tạo"
                               Height="26" Padding="10,0" Margin="0,0,4,4" FontSize="10.5"
                               ToolTip="AI phân tích đề bài / ảnh để sinh mô hình 3D HTML (Ctrl+Shift+G)"
                               Click="BtnAiGenerate_Click" />

                    <!-- Kho mô hình: Cyan đậm #0891B2 -->
                    <ui:Button x:Name="BtnOpenModelBank" Style="{StaticResource AccentVibrantButtonStyle}"
                               Background="#0891B2" Foreground="White" FontWeight="SemiBold"
                               Icon="{ui:SymbolIcon Book24}" Content="Kho mô hình"
                               Height="26" Padding="8,0" Margin="0,0,4,4" FontSize="10.5"
                               ToolTip="Mở kho lưu trữ duyệt và nạp các mẫu mô hình mô phỏng 3D HTML (Ctrl+B)"
                               Click="BtnOpenModelBank_Click" />

                    <!-- Lưu kho: Ngọc lục bảo #10B981 -->
                    <ui:Button x:Name="BtnSaveModelBank" Style="{StaticResource AccentVibrantButtonStyle}"
                               Background="#10B981" Foreground="White" FontWeight="SemiBold"
                               Icon="{ui:SymbolIcon Save24}" Content="Lưu kho"
                               Height="26" Padding="8,0" Margin="0,0,4,4" FontSize="10.5"
                               ToolTip="Lưu mô hình HTML hiện tại vào kho lưu trữ cá nhân (Ctrl+Shift+S)"
                               Click="BtnSaveModelBank_Click" />

                    <!-- Tạo lại: Màu Vàng cam #F59E0B -->
                    <ui:Button x:Name="BtnAiRegenerate" Style="{StaticResource AccentVibrantButtonStyle}"
                               Background="#F59E0B" Foreground="White" FontWeight="SemiBold"
                               Icon="{ui:SymbolIcon ArrowCounterclockwise24}" Content="Tạo lại"
                               Height="26" Padding="8,0" Margin="0,0,4,4" FontSize="10.5"
                               ToolTip="Tạo lại mô hình từ mô tả gần nhất"
                               Click="BtnAiRegenerate_Click" />

                    <!-- AI Sửa: Màu Xanh Cobalt #2563EB -->
                    <ui:Button x:Name="BtnAiEdit" Style="{StaticResource AccentVibrantButtonStyle}"
                               Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                               Icon="{ui:SymbolIcon Edit24}" Content="AI sửa"
                               Height="26" Padding="8,0" Margin="0,0,4,4" FontSize="10.5"
                               ToolTip="Yêu cầu AI chỉnh sửa hoặc bổ sung chi tiết vào mô hình HTML này"
                               Click="BtnAiEdit_Click" />

                    <!-- AI Tối ưu: Màu Tím đậm #9333EA -->
                    <ui:Button x:Name="BtnAiOptimize" Style="{StaticResource AccentVibrantButtonStyle}"
                               Background="#9333EA" Foreground="White" FontWeight="SemiBold"
                               Icon="{ui:SymbolIcon Sparkle24}" Content="AI tối ưu"
                               Height="26" Padding="8,0" Margin="0,0,4,4" FontSize="10.5"
                               ToolTip="Tối ưu hóa hiệu năng Three.js, KaTeX và làm sạch mã HTML"
                               Click="BtnAiOptimize_Click" />

                    <!-- Dán ảnh: Màu Slate #475569 -->
                    <ui:Button x:Name="BtnPasteImage" Style="{StaticResource AccentVibrantButtonStyle}"
                               Background="#475569" Foreground="White" FontWeight="SemiBold"
                               Icon="{ui:SymbolIcon Image24}" Content="Dán ảnh"
                               Height="26" Padding="8,0" Margin="0,0,10,4" FontSize="10.5"
                               ToolTip="Dán ảnh đề bài từ Clipboard để AI Vision phân tích dựng mô hình 3D (Ctrl+V)"
                               Click="BtnPasteImage_Click" />

                    <!-- Lưu file HTML: Xanh lá #059669 -->
                    <ui:Button x:Name="BtnSaveHtml" Style="{StaticResource AccentVibrantButtonStyle}"
                               Background="#059669" Foreground="White" FontWeight="SemiBold"
                               Icon="{ui:SymbolIcon DocumentSave24}" Content="Lưu HTML"
                               Height="26" Padding="8,0" Margin="0,0,4,4" FontSize="10"
                               ToolTip="Lưu tệp HTML hoàn chỉnh để mở trên web hoặc đưa lên LMS (Ctrl+S)"
                               Click="BtnSaveHtml_Click" />

                    <!-- Mở file: Xanh dương #0284C7 -->
                    <ui:Button x:Name="BtnOpenHtml" Style="{StaticResource AccentVibrantButtonStyle}"
                               Background="#0284C7" Foreground="White" FontWeight="SemiBold"
                               Icon="{ui:SymbolIcon FolderOpen24}" Content="Mở file"
                               Height="26" Padding="8,0" Margin="0,0,4,4" FontSize="10"
                               ToolTip="Mở tệp HTML mô hình có sẵn trên máy tính (Ctrl+O)"
                               Click="BtnOpenHtml_Click" />

                    <!-- Lọc mã sạch: Slate #64748B -->
                    <ui:Button x:Name="BtnCleanCode" Style="{StaticResource AccentVibrantButtonStyle}"
                               Background="#64748B" Foreground="White" FontWeight="SemiBold"
                               Icon="{ui:SymbolIcon Broom24}" Content="Lọc mã"
                               Height="26" Padding="8,0" Margin="0,0,4,4" FontSize="10"
                               ToolTip="Làm sạch và trích xuất khối HTML độc lập hoàn chỉnh"
                               Click="BtnCleanCode_Click" />

                    <!-- Xóa trắng: Đỏ Rose #DC2626 -->
                    <ui:Button x:Name="BtnClear" Style="{StaticResource AccentVibrantButtonStyle}"
                               Background="#DC2626" Foreground="White" FontWeight="SemiBold"
                               Icon="{ui:SymbolIcon Delete24}" Content="Xóa trắng"
                               Height="26" Padding="8,0" Margin="0,0,8,4" FontSize="10"
                               ToolTip="Xóa trắng mã soạn thảo"
                               Click="BtnClear_Click" />

                    <!-- Chạy thử: Hổ phách #EA580C -->
                    <ui:Button x:Name="BtnRun" Style="{StaticResource AccentVibrantButtonStyle}"
                               Background="#EA580C" Foreground="White" FontWeight="Bold"
                               Icon="{ui:SymbolIcon Play24}" Content="Chạy thử (F5)"
                               Height="26" Padding="12,0" Margin="0,0,0,4" FontSize="10.5"
                               ToolTip="Chạy mô phỏng tương tác trên khung xem trước (F5 hoặc Ctrl+Enter)"
                               Click="BtnRun_Click" />
                </WrapPanel>
            </Grid>
        </ui:Card>

        <!-- Khung Split View: Soạn thảo Mã HTML vs Trình xem Web tương tác -->
        <Grid x:Name="GridSplitContainer" Grid.Row="2" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColCode" Width="*" MinWidth="300" />
                <ColumnDefinition x:Name="ColSplitter" Width="8" />
                <ColumnDefinition x:Name="ColPreview" Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Mã nguồn HTML / JS -->
            <ui:Card x:Name="CardCode" Grid.Column="0" Padding="10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" AllowDrop="True" Drop="HtmlLeftCard_Drop" DragOver="HtmlLeftCard_DragOver">
                <Grid VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Code24" FontSize="14" Foreground="#0D9488" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Mã nguồn HTML / Three.js / JS" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="BtnAiAutoFix" Appearance="Danger"
                                       Icon="{ui:SymbolIcon Wrench24}"
                                       Content="Sửa lỗi bằng AI" Height="22" Padding="6,0" FontSize="10" Margin="0,0,4,0"
                                       Visibility="Collapsed" Click="BtnAiAutoFix_Click"
                                       ToolTip="Yêu cầu AI tự động sửa lỗi cú pháp JavaScript/Three.js" />

                            <ui:Button x:Name="BtnExpandPreviewFromCode" Appearance="Secondary"
                                       Icon="{ui:SymbolIcon ArrowRight24}"
                                       Content="Mở xem trước" Height="22" Padding="6,0" FontSize="10" Margin="0,0,4,0"
                                       Visibility="Collapsed" Click="BtnExpandPreviewFromCode_Click"
                                       ToolTip="Mở lại khung xem trước tương tác" />

                            <ui:Button x:Name="BtnCollapseCode" Appearance="Secondary"
                                       Icon="{ui:SymbolIcon ArrowLeft24}"
                                       Content="Đóng mã" Height="22" Padding="6,0" FontSize="10"
                                       ToolTip="Đóng khung mã để mở rộng vùng mô phỏng (Ctrl+[ hoặc F10)"
                                       Click="BtnCollapseCode_Click" />
                        </StackPanel>
                    </DockPanel>

                    <ui:TextBox x:Name="TxtHtmlCode" Grid.Row="1"
                                VerticalAlignment="Stretch" MinHeight="180"
                                AcceptsReturn="True" TextWrapping="Wrap"
                                VerticalContentAlignment="Top"
                                FontFamily="Consolas, 'Cascadia Code', monospace" FontSize="11"
                                Opacity="0.94"
                                ToolTip="Trình soạn thảo mã nguồn HTML / Three.js"
                                PlaceholderText="Nhập mô tả mô hình hoặc dán mã HTML/JS..." />

                    <!-- Ảnh đính kèm (nếu dán ảnh) -->
                    <Border x:Name="BorderAttachedImage" Grid.Row="2" Visibility="Collapsed" 
                            Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                            CornerRadius="6" Padding="6" Margin="0,6,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Cursor="Hand" Background="Transparent"
                                        MouseLeftButtonDown="AttachedImage_Click"
                                        ToolTip="Nhấp chuột để xem ảnh mẫu đính kèm">
                                <Border CornerRadius="4" ClipToBounds="True" Margin="0,0,8,0">
                                    <Image x:Name="ImgAttachedPreview" Width="36" Height="36" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Ảnh đề bài / hình vẽ đính kèm" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Text=" (Bấm để xem)" FontSize="10" Foreground="#0D9488" FontWeight="SemiBold" Margin="4,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="Được AI Vision phân tích để dựng mô hình 3D tương ứng" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <ui:Button x:Name="BtnRemoveImage" Appearance="Transparent" 
                                       Icon="{ui:SymbolIcon Dismiss24}" 
                                       ToolTip="Gỡ bỏ ảnh mẫu (Delete)"
                                       HorizontalAlignment="Right" Click="BtnRemoveImage_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </ui:Card>

            <GridSplitter x:Name="SplitterHtml" Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Cột phải: Xem trước Trực quan & Tương tác -->
            <ui:Card x:Name="CardPreview" Grid.Column="2" Padding="10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header Cột phải: View mode tabs & Action export buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <DockPanel LastChildFill="False">
                            <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="BtnExpandCode" Style="{StaticResource AccentVibrantButtonStyle}"
                                           Background="#0D9488" Foreground="White" FontWeight="Bold"
                                           Icon="{ui:SymbolIcon ArrowRight24}"
                                           Content="Mở mã" Height="24" Padding="8,0" FontSize="10" Margin="0,0,6,2"
                                           Visibility="Collapsed"
                                           ToolTip="Mở lại khung soạn thảo mã nguồn HTML"
                                           Click="BtnExpandCode_Click" />

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,2">
                                    <ui:SymbolIcon Symbol="Globe24" Foreground="#0D9488" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Xem trước Mô hình 3D" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>

                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Height="24" Padding="2,0" Margin="0,0,6,2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button x:Name="BtnModeSplit" Appearance="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Content="3:7" Height="20" Padding="5,0" FontSize="9.5" FontWeight="SemiBold"
                                                   ToolTip="Chế độ chia đôi (Mã 30% : Mô hình 70%)" Click="BtnModeSplit_Click" />
                                        <ui:Button x:Name="BtnModeModelOnly" Appearance="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Content="Chỉ mô hình" Height="20" Padding="5,0" FontSize="9.5" FontWeight="SemiBold"
                                                   ToolTip="Chế độ chỉ xem mô hình toàn màn hình" Click="BtnModeModelOnly_Click" />
                                        <ui:Button x:Name="BtnModeCodeOnly" Appearance="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Content="Chỉ mã" Height="20" Padding="5,0" FontSize="9.5" FontWeight="SemiBold"
                                                   ToolTip="Chế độ chỉ xem mã nguồn HTML" Click="BtnModeCodeOnly_Click" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <ui:Button x:Name="BtnOpenInBrowser" Style="{StaticResource AccentVibrantButtonStyle}"
                                           Background="#0284C7" Foreground="White" FontWeight="Bold"
                                           Icon="{ui:SymbolIcon Globe24}" Content="Mở trên Web"
                                           Height="24" Padding="8,0" Margin="0,0,3,2" FontSize="10" 
                                           ToolTip="Mở mô hình trực tiếp trên trình duyệt Web mặc định (Chrome/Edge)"
                                           Click="BtnOpenInBrowser_Click" />

                                <ui:Button x:Name="BtnCopyHtml" Style="{StaticResource AccentVibrantButtonStyle}"
                                           Background="#7C3AED" Foreground="White" FontWeight="SemiBold"
                                           Content="Copy HTML" Height="24" Padding="6,0" Margin="0,0,3,2" FontSize="10" 
                                           ToolTip="Sao chép toàn bộ mã nguồn HTML vào Clipboard"
                                           Click="BtnCopyHtml_Click" />

                                <ui:Button x:Name="BtnFullscreen" Appearance="Secondary" 
                                           Icon="{ui:SymbolIcon FullScreenMaximize24}" 
                                           Content="Xem riêng" Height="24" Padding="6,0" Margin="0,0,3,2" FontSize="10" 
                                           ToolTip="Mở cửa sổ xem riêng biệt hoặc toàn màn hình"
                                           Click="BtnFullscreen_Click" />
                            </WrapPanel>
                        </DockPanel>
                    </Grid>

                    <!-- Khung hiển thị mô hình WebView2 -->
                    <Border x:Name="BorderWebWrapper" Grid.Row="1" Background="#FFFFFF" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1.5" 
                            CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <wv2:WebView2 x:Name="WebViewControl" />

                            <!-- Placeholder khi chưa nạp mô hình -->
                            <StackPanel x:Name="PanelPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                                <ui:SymbolIcon Symbol="Cube24" FontSize="42" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="Mô hình 3D HTML sẽ hiển thị tương tác trực tiếp tại đây" 
                                           FontSize="12" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" />
                                <TextBlock Text="Nhập đề bài rồi bấm 'AI tạo' (Ctrl+Shift+G) hoặc mở 'Kho mô hình' (Ctrl+B)" 
                                           FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- Loading Overlay trực quan kèm đồng hồ đếm giây thời gian thực (0.0s) -->
                            <Border x:Name="BorderLoadingOverlay" Visibility="Collapsed" Background="#EB0F172A" CornerRadius="6"
                                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:ProgressRing IsIndeterminate="True" Width="44" Height="44" Foreground="#38BDF8" Margin="0,0,0,12" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TxtLoadingTitle" Text="AI đang phân tích &amp; lập trình mô hình 3D HTML..." 
                                               FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TxtLoadingTimer" Text="⏳ Thời gian xử lý: 0.0s" 
                                               FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,5,0,14" />
                                    <ui:Button x:Name="BtnCancelAiAction" Style="{StaticResource AccentVibrantButtonStyle}"
                                               Background="#EF4444" Foreground="White" FontWeight="Bold"
                                               Icon="{ui:SymbolIcon Dismiss24}" Content="Hủy tác vụ"
                                               Height="28" Padding="14,0" FontSize="11" HorizontalAlignment="Center"
                                               Click="BtnCancelAiAction_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Thanh trạng thái kết quả -->
                    <DockPanel Grid.Row="2" Margin="0,6,0,0" LastChildFill="False">
                        <TextBlock x:Name="TxtModelStats" DockPanel.Dock="Left" Text="Chưa chạy mô hình" 
                                   FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtRenderTime" DockPanel.Dock="Right" Text="Trạng thái: Sẵn sàng" 
                                   FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- Băng thông báo InfoBar -->
        <ui:InfoBar x:Name="InfoHtmlNotification" Grid.Row="3" Margin="0,8,0,0"
                    IsOpen="False" Severity="Success"
                    Title="Hoàn tất" 
                    Message="Mô hình mô phỏng HTML 3D đã sẵn sàng tương tác." />
    </Grid>
</UserControl>
