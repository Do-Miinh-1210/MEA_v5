<UserControl x:Class="MatrixExamAI.Desktop.Views.ExamMatrixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">
    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề Phân hệ -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="20" Foreground="#D97706" Margin="0,0,8,0" />
                    <TextBlock Text="Soạn đề theo Ma trận Chuẩn BGD — Cấu trúc Định dạng mới" 
                               FontSize="16" FontWeight="Bold" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <TextBlock Text="Cấu trúc đề 3 phần chuẩn THPT: Trắc nghiệm 4 phương án (12 câu), Đúng/Sai (4 câu), Trả lời ngắn (6 câu)" 
                           FontSize="11" Margin="28,2,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Bộ đếm tổng quan -->
            <Border Grid.Column="1" Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="DocumentCheckmark24" FontSize="16" Foreground="#D97706" Margin="0,0,6,0" />
                    <StackPanel>
                        <TextBlock Text="Tổng thang điểm" FontSize="9.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="22 câu • 10.0 điểm" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Thanh cấu hình Ma trận & Nút hành động (WrapPanel chống tràn tuyệt đối) -->
        <ui:Card Grid.Row="1" Margin="0,0,0,4" Padding="8,5">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,4">
                    <TextBlock Text="Môn học:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="CmbSubject" Width="125" Height="32" SelectedIndex="0" FontSize="11.5" 
                              Padding="8,0,24,0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Toán học" Padding="8,4" />
                        <ComboBoxItem Content="Vật lí" Padding="8,4" />
                        <ComboBoxItem Content="Hóa học" Padding="8,4" />
                        <ComboBoxItem Content="Sinh học" Padding="8,4" />
                        <ComboBoxItem Content="Lịch sử" Padding="8,4" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,4">
                    <TextBlock Text="Khối lớp:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="CmbGrade" Width="105" Height="32" SelectedIndex="2" FontSize="11.5" 
                              Padding="8,0,24,0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Lớp 10" Padding="8,4" />
                        <ComboBoxItem Content="Lớp 11" Padding="8,4" />
                        <ComboBoxItem Content="Lớp 12" Padding="8,4" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,4">
                    <TextBlock Text="Thời gian:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="CmbDuration" Width="110" Height="32" SelectedIndex="1" FontSize="11.5" 
                              Padding="8,0,24,0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="45 phút" Padding="8,4" />
                        <ComboBoxItem Content="90 phút" Padding="8,4" />
                        <ComboBoxItem Content="120 phút" Padding="8,4" />
                    </ComboBox>
                </StackPanel>

                <ui:Button x:Name="BtnLoadSample" Appearance="Secondary" 
                           Icon="{ui:SymbolIcon DocumentBulletList24}"
                           Content="Nạp đề mẫu chuẩn" Padding="10,5" Margin="0,0,6,4" FontSize="11"
                           Click="BtnLoadSample_Click"
                           ToolTip="Nạp cấu trúc đề thi mẫu 22 câu chuẩn BGD" />
                <ui:Button x:Name="BtnAiGenerateExam" Appearance="Primary" 
                           Icon="{ui:SymbolIcon Sparkle24}"
                           Content="AI Soạn đề tự động" Padding="12,5" Margin="0,0,6,4" FontSize="11"
                           Click="BtnAiGenerateExam_Click"
                           ToolTip="AI Gemini tự động sinh đề thi theo ma trận (F5 hoặc Ctrl + Enter)" />
                <ui:Button x:Name="BtnExportDocx" Appearance="Success" 
                           Icon="{ui:SymbolIcon DocumentArrowRight24}"
                           Content="Xuất file Word (.docx)" Padding="12,5" Margin="0,0,0,4" FontSize="11"
                           Click="BtnExportDocx_Click"
                           ToolTip="Xuất ma trận và đề thi ra tài liệu Word chuẩn A4 (Ctrl + S)" />
            </WrapPanel>
        </ui:Card>

        <!-- Khung Split View: Bảng ma trận tỷ lệ vs Trình xem nội dung đề -->
        <Grid Grid.Row="2" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Thống kê & Phân bổ câu hỏi theo 3 phần -->
            <ui:Card Grid.Column="0" Padding="10" VerticalAlignment="Stretch">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Phân bổ cấu trúc đề thi" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12" />

                        <!-- Phần I Card -->
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Phần I. Trắc nghiệm 4 lựa chọn" FontWeight="Bold" FontSize="12" Foreground="#0284C7" />
                                    <TextBlock Text="3.0 điểm" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="#0284C7" />
                                </Grid>
                                <TextBlock Text="12 câu hỏi (Mỗi câu 0.25đ, chọn 1 trong 4 đáp án A, B, C, D)" FontSize="11" Margin="0,4,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Grid>
                                    <TextBlock Text="Nhận biết: 6 | Thông hiểu: 4 | Vận dụng: 2" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Phần II Card -->
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Phần II. Trắc nghiệm Đúng / Sai" FontWeight="Bold" FontSize="12" Foreground="#8B5CF6" />
                                    <TextBlock Text="4.0 điểm" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="#8B5CF6" />
                                </Grid>
                                <TextBlock Text="4 câu hỏi (Mỗi câu gồm 4 lệnh hỏi a, b, c, d với thang điểm lũy tiến 0.1 - 0.25 - 0.5 - 1.0đ)" FontSize="11" Margin="0,4,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Grid>
                                    <TextBlock Text="Thông hiểu: 2 | Vận dụng: 2" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Phần III Card -->
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Phần III. Trắc nghiệm Trả lời ngắn" FontWeight="Bold" FontSize="12" Foreground="#10B981" />
                                    <TextBlock Text="3.0 điểm" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="#10B981" />
                                </Grid>
                                <TextBlock Text="6 câu hỏi (Mỗi câu 0.5đ, học sinh điền số thực hoặc phân số tối giản)" FontSize="11" Margin="0,4,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Grid>
                                    <TextBlock Text="Vận dụng: 4 | Vận dụng cao: 2" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4 Mức độ nhận thức chuẩn BGD 2025 -->
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="4 Mức độ nhận thức chuẩn BGD 2025" FontWeight="Bold" FontSize="12" Foreground="#D97706" />
                                <TextBlock Text="Tỉ lệ: Nhận biết 40% • Thông hiểu 30% • Vận dụng 20% • Vận dụng cao 10%" FontSize="10.5" Margin="0,4,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#0284C7" CornerRadius="4" Padding="4,2" Margin="0,0,2,0">
                                        <TextBlock Text="NB (6c)" FontSize="10" Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Grid.Column="1" Background="#8B5CF6" CornerRadius="4" Padding="4,2" Margin="2,0,2,0">
                                        <TextBlock Text="TH (6c)" FontSize="10" Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Grid.Column="2" Background="#10B981" CornerRadius="4" Padding="4,2" Margin="2,0,2,0">
                                        <TextBlock Text="VD (8c)" FontSize="10" Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Grid.Column="3" Background="#EC4899" CornerRadius="4" Padding="4,2" Margin="2,0,0,0">
                                        <TextBlock Text="VDC (2c)" FontSize="10" Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Tùy chọn chuyên đề -->
                        <TextBlock Text="Chuyên đề trọng tâm:" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,6" />
                        <TextBox x:Name="TxtExamTopic" Text="Khảo sát hàm số, Nguyên hàm - Tích phân, Hình học Oxyz" 
                                 FontFamily="Segoe UI" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <CheckBox x:Name="ChkIncludeAnswers" IsChecked="True" Content="Kèm bảng đáp án &amp; Lời giải chi tiết" Margin="0,0,0,6" />
                        <CheckBox x:Name="ChkBraceMathMatrix" IsChecked="True" Content="Tự động kẹp công thức ${...}$" Margin="0,0,0,6" />
                    </StackPanel>
                </ScrollViewer>
            </ui:Card>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Cột phải: Soạn thảo / Kết quả đề thi -->
            <ui:Card Grid.Column="2" Padding="10" VerticalAlignment="Stretch">
                <Grid VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DocumentBulletList24" Foreground="#D97706" Margin="0,0,6,0" />
                            <TextBlock Text="Nội dung Đề thi Hoàn chỉnh (Định dạng chuẩn Word)" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                        <TextBlock x:Name="TxtExamStats" Text="Đề thi: 22 câu hỏi" FontSize="11" HorizontalAlignment="Right" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <ui:TextBox x:Name="TxtExamContent" Grid.Row="1"
                                VerticalAlignment="Stretch"
                                AcceptsReturn="True" TextWrapping="Wrap"
                                VerticalContentAlignment="Top"
                                FontFamily="Consolas, 'Segoe UI', Arial" FontSize="12.5"
                                PlaceholderText="Bấm 'Nạp đề mẫu chuẩn' hoặc 'AI Soạn đề tự động' để tạo đề thi theo ma trận..." />

                    <ProgressBar x:Name="ProgExam" Grid.Row="2" Height="4" Margin="0,6,0,0" 
                                 Visibility="Collapsed" IsIndeterminate="True" />
                </Grid>
            </ui:Card>
        </Grid>

        <!-- Băng thông báo InfoBar -->
        <ui:InfoBar x:Name="InfoExamNotification" Grid.Row="3" Margin="0,12,0,0"
                    IsOpen="False" Severity="Success"
                    Title="Hoàn tất" 
                    Message="Đề thi theo ma trận đã sẵn sàng xuất ra tệp Word (.docx)." />
    </Grid>
</UserControl>
