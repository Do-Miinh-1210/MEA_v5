<Window x:Class="MatrixExamAI.Desktop.Views.AiMatrixDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="🤖 Tạo ma trận đề bằng AI" Height="540" Width="680" MinHeight="480" MinWidth="580"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC"
        TextElement.FontFamily="Segoe UI" TextElement.FontSize="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F2D52" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🤖  TẠO MA TRẬN ĐỀ BẰNG AI"
                               Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="AI tự động phân bổ câu hỏi theo chuẩn BGD"
                           Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <!-- Accent line -->
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="3" Background="#10B981" />

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
            <StackPanel Orientation="Vertical">
                <!-- Row 1: Môn học + Lớp -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Môn học:" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6" />
                        <ComboBox x:Name="CmbSubject" Height="32" SelectedIndex="0">
                            <ComboBoxItem Content="Toán" />
                            <ComboBoxItem Content="Vật lý" />
                            <ComboBoxItem Content="Hóa học" />
                            <ComboBoxItem Content="Sinh học" />
                            <ComboBoxItem Content="Ngữ văn" />
                            <ComboBoxItem Content="Tiếng Anh" />
                            <ComboBoxItem Content="Lịch sử" />
                            <ComboBoxItem Content="Địa lý" />
                            <ComboBoxItem Content="GDCD/GDKTPL" />
                            <ComboBoxItem Content="Tin học" />
                            <ComboBoxItem Content="Công nghệ" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Lớp:" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6" />
                        <ComboBox x:Name="CmbGrade" Height="32" SelectedIndex="6">
                            <ComboBoxItem Content="6" />
                            <ComboBoxItem Content="7" />
                            <ComboBoxItem Content="8" />
                            <ComboBoxItem Content="9" />
                            <ComboBoxItem Content="10" />
                            <ComboBoxItem Content="11" />
                            <ComboBoxItem Content="12" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Thời lượng + Học kỳ -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Thời lượng:" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6" />
                        <ComboBox x:Name="CmbDuration" Height="32" SelectedIndex="1">
                            <ComboBoxItem Content="15 phút" />
                            <ComboBoxItem Content="45 phút" />
                            <ComboBoxItem Content="60 phút" />
                            <ComboBoxItem Content="90 phút" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Học kỳ:" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6" />
                        <ComboBox x:Name="CmbSemester" Height="32" SelectedIndex="0">
                            <ComboBoxItem Content="I" />
                            <ComboBoxItem Content="II" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Row 3: Yêu cầu thêm -->
                <TextBlock Text="Yêu cầu thêm (tùy chọn):" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6" />
                <TextBox x:Name="TxtExtraRequirements" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Padding="8,6" Background="White" BorderBrush="#CBD5E1"
                         BorderThickness="1"
                         Text="• Tập trung chương Đạo hàm và Tích phân&#x0a;• Thêm bài tập thực tế, ứng dụng" />

                <!-- Info Box: AI sẽ tạo gì -->
                <Border Background="#EBF5FF" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,14,0,4">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="💡 AI sẽ tự động:" FontWeight="Bold" Foreground="#0284C7" FontSize="12.5" Margin="0,0,0,6" />
                        <TextBlock Text="• Phân bổ câu hỏi TN / DS / TLN / TL theo chuẩn BGD" Foreground="#334155" Margin="4,2,0,2" />
                        <TextBlock Text="• Chia mức độ NB / TH / VD phù hợp thời lượng" Foreground="#334155" Margin="4,2,0,2" />
                        <TextBlock Text="• Chọn chủ đề đa dạng theo chương trình lớp đã chọn" Foreground="#334155" Margin="4,2,0,2" />
                        <TextBlock Text="• Tổng điểm = 10.0, có yêu cầu cần đạt chi tiết" Foreground="#334155" Margin="4,2,0,2" />
                    </StackPanel>
                </Border>

                <!-- Trạng thái đang xử lý -->
                <StackPanel x:Name="PanelBusy" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="8" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtStatus" Text="Đang gọi AI tạo ma trận..." Foreground="#0284C7" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button x:Name="BtnGenerate" Grid.Column="1" Margin="0,0,8,0" Height="34" Padding="18,0"
                           Background="#10B981" Foreground="White" BorderThickness="0" CornerRadius="4"
                           FontSize="12" FontWeight="Bold" Cursor="Hand" Click="BtnGenerate_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🤖  Tạo ma trận" />
                    </StackPanel>
                </ui:Button>

                <ui:Button x:Name="BtnCancel" Grid.Column="2" Height="34" Padding="16,0"
                           Background="#64748B" Foreground="White" BorderThickness="0" CornerRadius="4"
                           FontSize="12" Cursor="Hand" Click="BtnCancel_Click" Content="Đóng" />
            </Grid>
        </Border>
    </Grid>
</Window>
