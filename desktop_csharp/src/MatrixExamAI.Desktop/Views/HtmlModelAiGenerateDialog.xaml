<Window x:Class="MatrixExamAI.Desktop.Views.HtmlModelAiGenerateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AI Tạo Mô hình Mô phỏng 3D HTML &amp; Khoa học"
        Height="630" Width="850" MinWidth="750" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Focusable="True"
        KeyDown="HtmlModelAiGenerateDialog_KeyDown">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" Background="#0891B2" CornerRadius="6" Padding="14,10" Margin="0,0,0,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                    <ui:SymbolIcon Symbol="Cube24" FontSize="15" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="AI Tạo Mô hình 3D HTML — Phân tích Đề bài &amp; Lập trình Mô phỏng" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Chỉ cần dán ảnh (Ctrl+V) hoặc nhập đề bài, AI sẽ tự động phân tích và lập trình tệp HTML 3D tương tác (Three.js + Tailwind + KaTeX)."
                           FontSize="10.5" Foreground="#CFFAFE" />
            </StackPanel>
        </Border>

        <!-- 2. Dải thông tin Provider hiện tại -->
        <Border Grid.Row="1" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
            <TextBlock x:Name="TxtActiveProvider" Text="⚡ Provider hiện tại: 9Router (gemini-3.8-flash)" 
                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
        </Border>

        <!-- 3. Scrollable Content Area -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
            <StackPanel>
                <!-- Bước 1: Hình ảnh bài toán -->
                <ui:Card Margin="0,0,0,8" Padding="12,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="1. Hình ảnh bài toán (Đề bài, hình không gian, đồ thị, phân tử...)" 
                                       FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ui:Button x:Name="BtnChooseImage" Icon="{ui:SymbolIcon FolderOpen24}" Content="Chọn ảnh từ máy" Background="#2563EB" Foreground="White" 
                                           FontWeight="SemiBold" Height="28" Padding="12,0" FontSize="11" Margin="0,0,6,0"
                                           Click="BtnChooseImage_Click" />
                                <ui:Button x:Name="BtnPasteImage" Icon="{ui:SymbolIcon ClipboardPaste24}" Content="Dán ảnh (Ctrl+V)" Background="#475569" Foreground="White" 
                                           FontWeight="SemiBold" Height="28" Padding="12,0" FontSize="11" Margin="0,0,6,0"
                                           Click="BtnPasteImage_Click" />
                                <ui:Button x:Name="BtnClearImage" Icon="{ui:SymbolIcon Delete24}" Content="Xóa ảnh" Background="#EF4444" Foreground="White" 
                                           FontWeight="SemiBold" Height="28" Padding="10,0" FontSize="10.5" Visibility="Collapsed"
                                           Click="BtnClearImage_Click" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Drop & Paste Zone khi chưa có ảnh -->
                        <Border x:Name="BorderDropZone" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,2,0,0"
                                AllowDrop="True" DragOver="BorderDropZone_DragOver" Drop="BorderDropZone_Drop" Cursor="Hand"
                                MouseLeftButtonDown="BorderDropZone_MouseLeftButtonDown">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Image24" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="Nhấn Ctrl+V để dán ảnh chụp màn hình bài toán từ Clipboard hoặc kéo thả ảnh vào đây"
                                           FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Preview container khi đã có ảnh -->
                        <Border x:Name="BorderImagePreview" Visibility="Collapsed" Background="#0A000000" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,2,0,0"
                                Cursor="Hand" MouseLeftButtonDown="BorderImagePreview_MouseLeftButtonDown"
                                ToolTip="Nhấp chuột để xem phóng to ảnh đính kèm">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Background="White" CornerRadius="4" Padding="2" Margin="0,0,12,0" MaxWidth="140" MaxHeight="90">
                                    <Image x:Name="ImgPreview" MaxWidth="136" MaxHeight="86" Stretch="Uniform" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock x:Name="TxtImageDimensions" Text="Kích thước: 0 x 0 px" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Text=" (Bấm để xem lớn)" FontSize="10" Foreground="#0891B2" FontWeight="SemiBold" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtImageSize" Text="Dung lượng: 0 KB" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="✓ Sẵn sàng gửi kèm yêu cầu cho AI Vision đối chiếu trực quan mô hình" FontSize="10" Foreground="#059669" FontWeight="SemiBold" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- Bước 2: Tùy chọn chuyên đề & cấu trúc mô phỏng -->
                <ui:Card Margin="0,0,0,8" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="2. Tùy chọn chuyên đề &amp; cấu trúc mô hình (Chuẩn STEM Three.js)" 
                                   FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <CheckBox x:Name="ChkSolidRev" Grid.Row="0" Grid.Column="0" Content="Khối tròn xoay (Tích phân)" IsChecked="True" FontSize="11" Margin="0,0,0,6" />
                            <CheckBox x:Name="ChkSpatial" Grid.Row="0" Grid.Column="1" Content="Hình không gian &amp; Thiết diện" FontSize="11" Margin="0,0,0,6" />
                            <CheckBox x:Name="ChkOxyz" Grid.Row="0" Grid.Column="2" Content="Tọa độ không gian Oxyz" FontSize="11" Margin="0,0,0,6" />

                            <CheckBox x:Name="ChkSurface" Grid.Row="1" Grid.Column="0" Content="Mặt cong 3D &amp; Đồ thị hàm số" FontSize="11" Margin="0,0,0,6" />
                            <CheckBox x:Name="ChkPhysics" Grid.Row="1" Grid.Column="1" Content="Vật lý: Dao động &amp; Sóng" FontSize="11" Margin="0,0,0,6" />
                            <CheckBox x:Name="ChkChemistry" Grid.Row="1" Grid.Column="2" Content="Hóa học: Phân tử 3D CPK" FontSize="11" Margin="0,0,0,6" />

                            <CheckBox x:Name="ChkBiology" Grid.Row="2" Grid.Column="0" Content="Sinh học: Chuỗi xoắn ADN" FontSize="11" Margin="0,0,0,0" />
                            <CheckBox x:Name="ChkSplitView" Grid.Row="2" Grid.Column="1" Content="Bố cục 2 cột (Mô phỏng + KaTeX)" IsChecked="True" FontSize="11" Margin="0,0,0,0" />
                            <CheckBox x:Name="ChkControls" Grid.Row="2" Grid.Column="2" Content="Tương tác xoay/zoom chuột" IsChecked="True" FontSize="11" Margin="0,0,0,0" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Bước 3: Yêu cầu bổ sung hoặc đề bài cụ thể -->
                <ui:Card Margin="0,0,0,8" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="3. Đề bài hoặc yêu cầu mô phỏng cụ thể (Văn bản)" 
                                   FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />
                        <ui:TextBox x:Name="TxtUserPrompt" MinHeight="75" MaxHeight="130" AcceptsReturn="True" TextWrapping="Wrap"
                                    VerticalContentAlignment="Top" FontSize="11.5"
                                    PlaceholderText="Dán toàn bộ đề bài toán học, định lý hình học, bài toán ứng dụng tích phân hoặc hiện tượng vật lý cần mô phỏng 3D tương tác tại đây..." />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- 4. Footer trạng thái -->
        <Border Grid.Row="3" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TxtStatus" DockPanel.Dock="Left" Text="Sẵn sàng — Dán ảnh (Ctrl+V) hoặc nhập đề bài rồi bấm 'Tạo mô hình'."
                           FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- 5. Hàng Nút Bấm Hành Động -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <ui:Button x:Name="BtnCancel" DockPanel.Dock="Left" Content="Đóng" MinWidth="85" Height="32"
                       Background="#475569" Foreground="White" FontSize="11"
                       Click="BtnCancel_Click" />

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button x:Name="BtnTextOnly" Content="Chỉ tạo từ mô tả" MinWidth="130" Height="32" Margin="0,0,8,0"
                           Background="#0284C7" Foreground="White" FontWeight="SemiBold" FontSize="11"
                           ToolTip="Bỏ qua ảnh đính kèm, chỉ tạo mô hình HTML 3D dựa trên văn bản đã nhập"
                           Click="BtnTextOnly_Click" />
                <ui:Button x:Name="BtnAnalyzeAndGenerate" Content="Phân tích &amp; Lập trình mô hình 3D HTML" MinWidth="220" Height="32"
                           Background="#0891B2" Foreground="White" FontWeight="Bold" FontSize="11"
                           Icon="{ui:SymbolIcon Sparkle24}"
                           ToolTip="AI Vision phân tích ảnh đính kèm kết hợp đề bài để tạo mô hình HTML 3D hoàn chỉnh"
                           Click="BtnAnalyzeAndGenerate_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
