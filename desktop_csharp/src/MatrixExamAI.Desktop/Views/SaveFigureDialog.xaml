<Window x:Class="MatrixExamAI.Desktop.Views.SaveFigureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Lưu hình vào kho hình vẽ TikZ"
        Height="420" Width="520" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Focusable="True"
        KeyDown="SaveFigureDialog_KeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#10B981" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="6" Background="#059669" Margin="0,0,10,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Save24" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Lưu hình vào kho hình vẽ TikZ" FontSize="13.5" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Lưu trữ để tái sử dụng, tìm kiếm và chèn nhanh vào các đề kiểm tra khác" FontSize="10.5" Foreground="#D1FAE5" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Body Form -->
        <StackPanel Grid.Row="1" VerticalAlignment="Stretch">
            <!-- Tên hình -->
            <TextBlock Text="Tên hình (*):" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:TextBox x:Name="TxtTitle" Height="30" FontSize="11" Padding="8,4" Margin="0,0,0,10"
                        PlaceholderText="Nhập tên gọi hoặc chủ đề hình (VD: Chóp S.ABCD đáy vuông, Đồ thị bậc 3...)" />

            <!-- Mô tả ngắn -->
            <TextBlock Text="Mô tả ngắn (tùy chọn):" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:TextBox x:Name="TxtDescription" Height="70" FontSize="11" Padding="8,4" Margin="0,0,0,10"
                        AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                        PlaceholderText="Ghi chú thêm về dạng bài, thông số hoặc lưu ý dựng hình..." />

            <!-- Tags -->
            <TextBlock Text="Thẻ phân loại (cách nhau bởi dấu phẩy):" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:TextBox x:Name="TxtTags" Height="30" FontSize="11" Padding="8,4" Margin="0,0,0,12"
                        PlaceholderText="VD: 3D, hinh_chop, de_thi_2025, tkz-tab" />

            <!-- Tùy chọn lưu PNG -->
            <CheckBox x:Name="ChkSavePng" Content="Lưu kèm ảnh đã biên dịch (PNG sắc nét 600 DPI để xem trước ngay)" 
                      IsChecked="True" FontSize="11" FontWeight="SemiBold"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </StackPanel>

        <!-- Footer Buttons -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <ui:Button x:Name="BtnCancel" DockPanel.Dock="Left" Icon="{ui:SymbolIcon Dismiss24}" Content="Hủy"
                       Background="#64748B" Foreground="White" FontWeight="SemiBold"
                       Height="30" Padding="14,0" FontSize="11" Click="BtnCancel_Click" />

            <ui:Button x:Name="BtnSave" DockPanel.Dock="Right" Icon="{ui:SymbolIcon Save24}" Content="Lưu vào kho"
                       Background="#10B981" Foreground="White" FontWeight="Bold"
                       Height="30" Padding="18,0" FontSize="11.5" Click="BtnSave_Click" />
        </DockPanel>
    </Grid>
</Window>
