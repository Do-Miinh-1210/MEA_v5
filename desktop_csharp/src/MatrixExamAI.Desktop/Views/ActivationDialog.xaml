<ui:FluentWindow x:Class="MatrixExamAI.Desktop.Views.ActivationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Kích hoạt Bản quyền MatrixExamAI Pro" 
        Height="700" Width="880"
        MinHeight="600" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid Margin="20,10,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Kích hoạt Bản quyền Trực tuyến • MatrixExamAI Pro" ShowMaximize="True" ShowMinimize="True" />

        <!-- 2. Scrollable Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,10">
            <StackPanel>
                <!-- Header Card: Trạng thái bản quyền hiện tại -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                        CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image Source="/MatrixExamAI.Desktop;component/Assets/logo.png" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MatrixExamAI Pro v5.1.3.3" FontSize="16" FontWeight="Bold" />
                                <Border x:Name="BadgeLicenseStatus" Background="#1A10B981" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtBadgeStatus" Text="ĐÃ KÍCH HOẠT PRO" Foreground="#10B981" FontSize="10" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtLicenseDetail" Text="Chủ sở hữu: Thầy Đỗ Minh • Thời hạn: Vĩnh viễn • Máy chủ: Trực tuyến (Cloud)" 
                                       FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <ui:Button x:Name="BtnRefreshStatus" Grid.Column="2" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowSync24}" 
                                   Content="Kiểm tra Trực tuyến" Padding="12,6" VerticalAlignment="Center" Click="BtnRefreshStatus_Click" 
                                   ToolTip="Đồng bộ và kiểm tra trạng thái giấy phép từ máy chủ bản quyền" />
                    </Grid>
                </Border>

                <!-- Machine ID Box -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                        CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mã máy tính định danh (Machine ID):" FontWeight="SemiBold" FontSize="12.5" />
                            <TextBlock x:Name="TxtMachineId" Text="XXXX-XXXX-XXXX" FontFamily="Consolas, monospace" FontSize="18" FontWeight="Bold" 
                                       Foreground="#0284C7" Margin="0,4,0,2" />
                            <TextBlock x:Name="TxtHardwareDisplay" Text="Windows 11 Hardware Guid" FontSize="11" 
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <ui:Button x:Name="BtnCopyMid" Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon Copy24}" 
                                   Content="Sao chép Mã máy" Padding="14,8" VerticalAlignment="Center" Click="BtnCopyMid_Click" 
                                   ToolTip="Sao chép Mã máy tính để gửi cho Admin kích hoạt" />
                    </Grid>
                </Border>

                <!-- Two-Column Activation & Payment Section -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <!-- Cột trái: Nhập mã kích hoạt trực tuyến -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                            CornerRadius="8" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:SymbolIcon Symbol="Key24" FontSize="16" Foreground="#0D9488" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Kích hoạt trực tuyến (Online Activation)" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="Họ tên Giáo viên / Đơn vị sử dụng:" FontSize="11.5" FontWeight="Medium" Margin="0,0,0,4" />
                            <ui:TextBox x:Name="TxtOwnerName" PlaceholderText="Ví dụ: Thầy Đỗ Minh (THPT Chuyên)..." Margin="0,0,0,12" />

                            <TextBlock Text="Mã bản quyền (License Key / Code):" FontSize="11.5" FontWeight="Medium" Margin="0,0,0,4" />
                            <ui:TextBox x:Name="TxtLicenseKey" PlaceholderText="Dán mã kích hoạt được cấp (ví dụ: MEA-VIP-2026)..." 
                                        FontFamily="Consolas, monospace" Margin="0,0,0,14" />

                            <ui:Button x:Name="BtnActivateOnline" Appearance="Primary" Icon="{ui:SymbolIcon CheckmarkCircle24}" 
                                       Content="Kích hoạt Bản quyền ngay" HorizontalAlignment="Stretch" Padding="0,10" 
                                       FontWeight="SemiBold" Click="BtnActivateOnline_Click" />

                            <TextBlock Text="* Lưu ý: Mã bản quyền được lưu trữ bảo mật trên hệ thống máy chủ và tự động liên kết với phần cứng máy tính." 
                                       FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Cột phải: Thanh toán VietQR & Thông tin Admin -->
                    <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                            CornerRadius="8" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:SymbolIcon Symbol="QrCode24" FontSize="16" Foreground="#0284C7" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Đăng ký mới qua VietQR" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Gói dịch vụ -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Gói dịch vụ:" VerticalAlignment="Center" FontSize="11.5" FontWeight="Medium" Margin="0,0,8,0" />
                                <ComboBox x:Name="CmbPricingPackage" Grid.Column="1" SelectionChanged="CmbPricingPackage_SelectionChanged">
                                    <ComboBoxItem Content="PRO (6 tháng) • 1.099.000 đ [Khuyên dùng]" Tag="pro|6|1099000" IsSelected="True" />
                                    <ComboBoxItem Content="PRO (12 tháng) • 1.999.000 đ" Tag="pro|12|1999000" />
                                    <ComboBoxItem Content="PREMIUM (6 tháng) • 1.599.000 đ" Tag="premium|6|1599000" />
                                    <ComboBoxItem Content="PREMIUM (12 tháng) • 2.999.000 đ" Tag="premium|12|2999000" />
                                    <ComboBoxItem Content="BASIC (Dùng thử) • Tùy chọn" Tag="basic|trial|50000" />
                                </ComboBox>
                            </Grid>

                            <!-- Ảnh VietQR -->
                            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                                    CornerRadius="6" Background="White" Width="160" Height="160" HorizontalAlignment="Center" Margin="0,4,0,8">
                                <Image x:Name="ImgVietQr" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" />
                            </Border>

                            <TextBlock Text="Quét QR bằng ứng dụng Ngân hàng để thanh toán tự động với nội dung là Mã máy tính của bạn." 
                                       FontSize="10.5" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <!-- Thông tin Admin -->
                            <Border Background="#0A0284C7" CornerRadius="4" Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="Vietcombank: 1017919118 • DO HUYNH BINH MINH" FontSize="10.5" FontWeight="SemiBold" Foreground="#0284C7" />
                                    <TextBlock Text="Hỗ trợ &amp; Zalo: 033.999.8261 (Thầy Đỗ Minh)" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- InfoNotification -->
                <ui:InfoBar x:Name="InfoActivation" Margin="0,4,0,0" IsOpen="False" />
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Bottom Bar -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtFooterNote" Text="MatrixExamAI kết nối trực tiếp hệ thống máy chủ bản quyền bảo mật tốc độ cao." 
                       FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />

            <ui:Button x:Name="BtnClose" Grid.Column="1" Appearance="Secondary" Content="Đóng" 
                       Padding="20,6" Click="BtnClose_Click" />
        </Grid>
    </Grid>
</ui:FluentWindow>
