<UserControl x:Class="MatrixExamAI.Desktop.Views.ShuffleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">
    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề Phân hệ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ArrowShuffle24" FontSize="24" Foreground="#EC4899" Margin="0,0,10,0" />
                    <TextBlock Text="Trộn đề Hoán vị &amp; Phiếu Trả lời Trắc nghiệm OMR" 
                               FontSize="20" FontWeight="Bold" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <TextBlock Text="Hoán vị câu hỏi và phương án A-B-C-D thông minh, sinh ma trận bảng đáp án chéo, tương thích máy chấm thi OMR" 
                           FontSize="12" Margin="34,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Thanh cấu hình Trộn đề (WrapPanel chống tràn) -->
        <ui:Card Grid.Row="1" Margin="0,0,0,14" Padding="10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,4">
                    <TextBlock Text="Số mã đề:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="CmbExamCodesCount" Width="120" Height="32" SelectedIndex="0" FontSize="11.5" 
                              Padding="8,0,24,0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="4 mã đề" Padding="8,4" />
                        <ComboBoxItem Content="8 mã đề" Padding="8,4" />
                        <ComboBoxItem Content="12 mã đề" Padding="8,4" />
                        <ComboBoxItem Content="24 mã đề" Padding="8,4" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,4">
                    <TextBlock Text="Mã đề bắt đầu:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="TxtStartCode" Text="101" Width="60" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="11.5" />
                </StackPanel>

                <CheckBox x:Name="ChkShuffleOptions" IsChecked="True" Content="Hoán vị A-B-C-D" Margin="0,0,12,4" FontSize="11" VerticalAlignment="Center" />
                <CheckBox x:Name="ChkPreserveAllAbove" IsChecked="True" Content="Cố định 'Cả A và B'" Margin="0,0,14,4" FontSize="11" VerticalAlignment="Center" />

                <ui:Button x:Name="BtnShuffle" Appearance="Primary" 
                           Icon="{ui:SymbolIcon ArrowShuffle24}"
                           Content="Tiến hành Trộn đề" Padding="12,5" Margin="0,0,6,4" FontSize="11"
                           Click="BtnShuffle_Click"
                           ToolTip="Hoán vị câu hỏi, phương án và sinh ma trận mã đề chéo (F5)" />
                <ui:Button x:Name="BtnGenerateOmr" Appearance="Secondary" 
                           Icon="{ui:SymbolIcon Print24}"
                           Content="Sinh Phiếu OMR" Padding="12,5" Margin="0,0,6,4" FontSize="11"
                           Click="BtnGenerateOmr_Click"
                           ToolTip="Sinh phiếu trả lời trắc nghiệm tô tròn OMR chuẩn A4" />
                <ui:Button x:Name="BtnExportAllDocx" Appearance="Success" 
                           Icon="{ui:SymbolIcon DocumentArrowRight24}"
                           Content="Xuất các file Word" Padding="12,5" Margin="0,0,0,4" FontSize="11"
                           Click="BtnExportAllDocx_Click"
                           ToolTip="Xuất toàn bộ các mã đề thi đã trộn ra các tệp Word riêng biệt (Ctrl + S)" />
            </WrapPanel>
        </ui:Card>

        <!-- Khung xem trước bảng ma trận đáp án sau khi trộn -->
        <ui:Card Grid.Row="2" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Table24" Foreground="#EC4899" Margin="0,0,6,0" />
                        <TextBlock Text="Ma trận Đáp án Đối chiếu sau khi Hoán vị" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                    <TextBlock x:Name="TxtShuffleStats" Text="Sẵn sàng trộn 4 mã đề: 101, 102, 103, 104" FontSize="11" HorizontalAlignment="Right" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>

                <ui:TextBox x:Name="TxtShuffleMatrixResult" Grid.Row="1"
                            IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            FontFamily="Consolas, 'Segoe UI', Arial" FontSize="12.5"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Grid>
        </ui:Card>

        <!-- InfoBar -->
        <ui:InfoBar x:Name="InfoShuffleNotification" Grid.Row="3" Margin="0,12,0,0"
                    IsOpen="False" Severity="Success"
                    Title="Hoàn tất" 
                    Message="Đã tạo 4 mã đề và ma trận đáp án thành công." />
    </Grid>
</UserControl>
