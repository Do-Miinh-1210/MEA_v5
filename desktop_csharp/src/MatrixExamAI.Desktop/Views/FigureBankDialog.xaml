<Window x:Class="MatrixExamAI.Desktop.Views.FigureBankDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Kho hình vẽ TikZ — MatrixExamAI Pro"
        Height="650" Width="1020" MinWidth="850" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Focusable="True"
        KeyDown="FigureBankDialog_KeyDown">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Kho hình -->
        <Border Grid.Row="0" Background="#0891B2" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="6" Background="#0E7490" Margin="0,0,8,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Book24" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Kho hình vẽ TikZ &amp; Thư viện đồ họa" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    <Border Background="#1AFFFFFF" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTotalCount" Text="0 hình vẽ" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnOpenFolder" Appearance="Transparent" 
                               Icon="{ui:SymbolIcon FolderOpen24}" Content="Mở thư mục kho" 
                               Foreground="White" FontSize="11" Height="26" Padding="8,0"
                               ToolTip="Mở thư mục lưu trữ các tệp .tex và .png trên ổ đĩa"
                               Click="BtnOpenFolder_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Thanh tìm kiếm, bộ lọc nguồn và chế độ xem -->
        <ui:Card Grid.Row="1" Margin="0,0,0,8" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Search24" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <ui:TextBox x:Name="TxtSearchQuery" Width="290" Height="26" FontSize="11" Padding="6,2"
                                PlaceholderText="Tìm theo tên, thẻ tags (VD: 3D, chop, do_thi, tkz-tab)..."
                                TextChanged="TxtSearchQuery_TextChanged" />
                </StackPanel>

                <!-- Filter Nguồn -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,14,0">
                    <TextBlock Text="Nguồn:" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="CmbSourceFilter" Width="150" Height="28" SelectedIndex="0" FontSize="11"
                              VerticalContentAlignment="Center"
                              SelectionChanged="CmbSourceFilter_SelectionChanged">
                        <ComboBoxItem Content="Tất cả nguồn" Tag="all" />
                        <ComboBoxItem Content="🤖 AI tạo" Tag="ai" />
                        <ComboBoxItem Content="✋ Thủ công" Tag="manual" />
                        <ComboBoxItem Content="📐 Mẫu đồ họa" Tag="template" />
                        <ComboBoxItem Content="🗂 Đề thi NHCH" Tag="nhch" />
                        <ComboBoxItem Content="💾 Tự lưu render" Tag="rendered" />
                    </ComboBox>
                </StackPanel>

                <!-- Chuyển đổi hiển thị: Thẻ ảnh vs Danh sách -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Dạng xem:" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <RadioButton x:Name="RbViewCards" Content="Thẻ ảnh" IsChecked="True" FontSize="10.5" FontWeight="SemiBold"
                                 Checked="ViewMode_Changed" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <RadioButton x:Name="RbViewList" Content="Danh sách" FontSize="10.5" FontWeight="SemiBold"
                                 Checked="ViewMode_Changed" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 3. Khu vực Split View: Thẻ ảnh/Danh sách hình (Trái) & Xem trước (Phải) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.5*" MinWidth="340" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="3.5*" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Thẻ ảnh (Gallery) hoặc Danh sách (Table) -->
            <Grid Grid.Column="0">
                <!-- Chế độ 1: Thẻ ảnh (Cards Gallery View) -->
                <ui:Card x:Name="CardViewContainer" Padding="4">
                    <ListBox x:Name="ListCardsFigures"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionMode="Single"
                             SelectionChanged="ListCardsFigures_SelectionChanged"
                             MouseDoubleClick="ListCardsFigures_MouseDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="4" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CardBorder" CornerRadius="8"
                                                    BorderThickness="1.5" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                    Padding="0" Cursor="Hand" SnapsToDevicePixels="True">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#0EA5E9" />
                                                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#0891B2" />
                                                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="138" Height="165" CornerRadius="8" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="105" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Khung ảnh thu nhỏ nền sáng tương phản cao -->
                                        <Border Grid.Row="0" Background="#F8FAFC" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                            <Grid>
                                                <!-- Placeholder khi chưa có ảnh render -->
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Image24" FontSize="28" Foreground="#CBD5E1" HorizontalAlignment="Center" />
                                                    <TextBlock Text="TikZ" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <!-- Ảnh thu nhỏ render thực tế -->
                                                <Image Source="{Binding ThumbnailSource}" Stretch="Uniform" Margin="4"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                        </Border>

                                        <!-- Thông tin tên hình và ID -->
                                        <Grid Grid.Row="1" Margin="6,4,6,4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <DockPanel Grid.Row="0" LastChildFill="False">
                                                <Border Background="#0891B2" CornerRadius="4" Padding="5,1" DockPanel.Dock="Left">
                                                    <TextBlock Text="{Binding Id, StringFormat='#{0}'}" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                                <TextBlock Text="{Binding Source}" FontSize="9" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           DockPanel.Dock="Right" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="10.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="32"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ui:Card>

                <!-- Chế độ 2: Bảng danh sách truyền thống -->
                <ui:Card x:Name="ListViewContainer" Padding="4" Visibility="Collapsed">
                    <DataGrid x:Name="GridFigures" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              BorderThickness="0" Background="Transparent"
                              SelectionChanged="GridFigures_SelectionChanged"
                              MouseDoubleClick="GridFigures_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45" />
                            <DataGridTextColumn Header="Tên hình vẽ" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="Nguồn" Binding="{Binding Source}" Width="75" />
                            <DataGridTextColumn Header="Tags" Binding="{Binding TagsDisplay}" Width="100" />
                            <DataGridTextColumn Header="Ngày tạo" Binding="{Binding CreatedAtDisplay}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </ui:Card>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Cột phải: Xem trước Ảnh PNG và Mã TikZ -->
            <ui:Card Grid.Column="2" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header chi tiết hình đang chọn -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSelectedTitle" Text="Chưa chọn hình vẽ" FontWeight="Bold" FontSize="12" />
                            <TextBlock x:Name="TxtSelectedMeta" Text="Nhấp chọn một thẻ ảnh để xem trước" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="BtnPopoutPreview" Appearance="Secondary" 
                                       Icon="{ui:SymbolIcon FullScreenMaximize24}" Content="Xem riêng"
                                       Height="24" Padding="8,0" FontSize="10" Margin="0,0,4,0"
                                       Click="BtnPopoutPreview_Click" ToolTip="Mở cửa sổ xem hình chi tiết toàn màn hình" />
                        </StackPanel>
                    </DockPanel>

                    <!-- TabControl Xem trước: Ảnh PNG vs Mã TikZ -->
                    <TabControl Grid.Row="1" Margin="0,4,0,0">
                        <TabItem Header="🖼 Ảnh xem trước (PNG)">
                            <Border Background="#F8FAFC" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                                        <Image x:Name="ImgPreview" MaxWidth="500" MaxHeight="380" Stretch="Uniform" 
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               MouseLeftButtonDown="ImgPreview_MouseLeftButtonDown"
                                               Cursor="Hand" ToolTip="Nhấp chuột để mở xem riêng phóng to" />
                                        <StackPanel x:Name="PanelNoImage" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ImageOff24" FontSize="32" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock Text="Chưa có ảnh render sẵn cho hình này" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                            <TextBlock Text="(Khi nạp vào trình soạn thảo sẽ tự động biên dịch)" FontSize="10" Foreground="#CBD5E1" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </TabItem>

                        <TabItem Header="📋 Mã LaTeX TikZ">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Toolbar Cập nhật / Lưu đè mã TikZ -->
                                <Border Grid.Row="0" Margin="0,0,0,6" Padding="6,4"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="4">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Edit24" FontSize="14" Foreground="#0891B2" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Có thể chỉnh sửa mã bên dưới rồi bấm Lưu đè để cập nhật vào kho" FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ui:Button x:Name="BtnUpdateCode" DockPanel.Dock="Right" Style="{DynamicResource AccentVibrantButtonStyle}"
                                                   Icon="{ui:SymbolIcon Save24}" Content="Lưu đè mã TikZ"
                                                   Background="#0891B2" Foreground="White" FontWeight="Bold"
                                                   Height="24" Padding="10,0" FontSize="10.5"
                                                   Click="BtnUpdateCode_Click"
                                                   ToolTip="Ghi đè mã TikZ mới này vào kho cho hình đang chọn" />
                                    </DockPanel>
                                </Border>

                                <ui:TextBox Grid.Row="1" x:Name="TxtTikzCodePreview" AcceptsReturn="True" TextWrapping="Wrap"
                                            IsReadOnly="False" VerticalContentAlignment="Top"
                                            FontFamily="Consolas, 'Cascadia Code', monospace" FontSize="10.5" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- 4. Thanh nút hành động cố định ở đáy -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <ui:Button x:Name="BtnLoadFigure" Style="{DynamicResource AccentVibrantButtonStyle}"
                           Icon="{ui:SymbolIcon ArrowDownload24}" Content="Nạp vào trình soạn thảo"
                           Background="#10B981" Foreground="White" FontWeight="Bold"
                           Height="30" Padding="16,0" FontSize="11" Margin="0,0,6,0"
                           Click="BtnLoadFigure_Click" ToolTip="Nạp mã TikZ và ảnh sẵn có vào phân hệ vẽ hình (Enter hoặc Double-click)" />

                <ui:Button x:Name="BtnCopyCode" Style="{DynamicResource AccentVibrantButtonStyle}"
                           Icon="{ui:SymbolIcon Copy24}" Content="Sao chép mã"
                           Background="#3B82F6" Foreground="White" FontWeight="SemiBold"
                           Height="30" Padding="12,0" FontSize="10.5" Margin="0,0,6,0"
                           Click="BtnCopyCode_Click" ToolTip="Sao chép mã TikZ vào Clipboard (Ctrl+C)" />

                <ui:Button x:Name="BtnDeleteFigure" Style="{DynamicResource AccentVibrantButtonStyle}"
                           Icon="{ui:SymbolIcon Delete24}" Content="Xóa hình"
                           Background="#EF4444" Foreground="White" FontWeight="SemiBold"
                           Height="30" Padding="10,0" FontSize="10.5"
                           Click="BtnDeleteFigure_Click" ToolTip="Xóa vĩnh viễn hình vẽ này khỏi kho" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button x:Name="BtnClose" Style="{DynamicResource AccentVibrantButtonStyle}"
                           Icon="{ui:SymbolIcon Dismiss24}" Content="Đóng"
                           Background="#64748B" Foreground="White" FontWeight="SemiBold"
                           Height="30" Padding="16,0" FontSize="11"
                           Click="BtnClose_Click" ToolTip="Đóng kho hình (Esc)" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
