<Window x:Class="MatrixExamAI.Desktop.Views.HtmlModelBankDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Kho lưu trữ mô hình mô phỏng 3D HTML — MatrixExamAI Pro"
        Height="680" Width="1060" MinWidth="880" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Focusable="True"
        KeyDown="HtmlModelBankDialog_KeyDown">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Header Kho mô hình -->
        <Border Grid.Row="0" Background="#0891B2" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="6" Background="#0E7490" Margin="0,0,8,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Cube24" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Kho lưu trữ mô hình mô phỏng 3D HTML" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    <Border Background="#1AFFFFFF" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTotalCount" Text="0 mô hình" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnOpenFolder" Appearance="Transparent" 
                               Icon="{ui:SymbolIcon FolderOpen24}" Content="Mở thư mục kho" 
                               Foreground="White" FontSize="11" Height="26" Padding="8,0"
                               ToolTip="Mở thư mục lưu trữ các tệp HTML mô hình trên ổ đĩa"
                               Click="BtnOpenFolder_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Thanh tìm kiếm, bộ lọc chuyên đề và nguồn -->
        <ui:Card Grid.Row="1" Margin="0,0,0,8" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Search24" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <ui:TextBox x:Name="TxtSearchQuery" Width="300" Height="32" FontSize="11" Padding="6,2"
                                PlaceholderText="Tìm theo tên, chuyên đề (VD: khối tròn xoay, chóp, con lắc, ADN)..."
                                TextChanged="TxtSearchQuery_TextChanged" />
                </StackPanel>

                <!-- Filter Chuyên đề -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,10,0">
                    <TextBlock Text="Chuyên đề:" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="CmbCategoryFilter" Width="210" Height="32" SelectedIndex="0" FontSize="11"
                              VerticalContentAlignment="Center"
                              SelectionChanged="CmbCategoryFilter_SelectionChanged">
                        <ComboBoxItem Content="Tất cả chuyên đề" Tag="all" />
                        <ComboBoxItem Content="Toán 12: Khối tròn xoay &amp; Tích phân" Tag="tron_xoay" />
                        <ComboBoxItem Content="Toán học: Hình không gian &amp; Thiết diện 3D" Tag="khong_gian" />
                        <ComboBoxItem Content="Toán học: Tọa độ không gian Oxyz" Tag="oxyz" />
                        <ComboBoxItem Content="Toán học: Đồ thị hàm số &amp; Mặt cong 3D" Tag="mat_cong" />
                        <ComboBoxItem Content="Vật lý: Dao động điều hòa &amp; Sóng cơ" Tag="vat_ly" />
                        <ComboBoxItem Content="Hóa học: Cấu trúc phân tử 3D" Tag="hoa_hoc" />
                        <ComboBoxItem Content="Sinh học: Cấu trúc ADN &amp; Tế bào" Tag="sinh_hoc" />
                        <ComboBoxItem Content="Mô hình cá nhân tự lưu" Tag="user" />
                    </ComboBox>
                </StackPanel>

                <!-- Filter Nguồn -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Nguồn:" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="CmbSourceFilter" Width="135" Height="32" SelectedIndex="0" FontSize="11"
                              VerticalContentAlignment="Center"
                              SelectionChanged="CmbSourceFilter_SelectionChanged">
                        <ComboBoxItem Content="Tất cả nguồn" Tag="all" />
                        <ComboBoxItem Content="📐 Mẫu chuẩn STEM" Tag="template" />
                        <ComboBoxItem Content="💾 Tự lưu cá nhân" Tag="user" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 3. Khu vực Split View: Danh sách mô hình (Trái) & Chi tiết + Xem trước (Phải) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.8*" MinWidth="340" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="4.2*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Danh sách thẻ mô hình -->
            <ui:Card Grid.Column="0" Padding="4">
                <ListBox x:Name="ListModels"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="ListModels_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,8" />
                            <Setter Property="Margin" Value="2,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    CornerRadius="6" Padding="10,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Tiêu đề & Nguồn badge -->
                                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12.5"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="240" VerticalAlignment="Center" />
                                        <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1A0891B2" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTemplate}" Value="false">
                                                            <Setter Property="Background" Value="#1A10B981" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="9.5" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="📐 Chuẩn STEM" />
                                                        <Setter Property="Foreground" Value="#0891B2" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTemplate}" Value="false">
                                                                <Setter Property="Text" Value="💾 Cá nhân" />
                                                                <Setter Property="Foreground" Value="#10B981" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DockPanel>

                                    <!-- Chuyên đề -->
                                    <TextBlock Grid.Row="1" Text="{Binding Category}" FontSize="10.5"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               FontWeight="Medium" Margin="0,0,0,4" />

                                    <!-- Mô tả ngắn gọn -->
                                    <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="10"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ui:Card>

            <!-- GridSplitter phân cách -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False" Cursor="SizeWE" />

            <!-- Cột phải: Xem chi tiết mô hình & Thao tác nạp -->
            <ui:Card Grid.Column="2" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header chi tiết -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="TxtDetailTitle" Text="Chọn một mô hình để xem chi tiết" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtDetailCategory" Text="Chuyên đề: Chưa chọn" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtDetailDescription" Text="Mô tả kỹ thuật của mô hình mô phỏng..." FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Thanh nút thao tác -->
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <!-- Nạp vào khung soạn thảo -->
                        <ui:Button x:Name="BtnApplyModel" Appearance="Primary"
                                   Icon="{ui:SymbolIcon ArrowDownload24}" Content="Nạp vào khung soạn thảo"
                                   Height="30" Padding="12,0" Margin="0,0,6,4" FontWeight="Bold"
                                   ToolTip="Nạp toàn bộ mã nguồn mô hình này vào khung soạn thảo (Enter)"
                                   Click="BtnApplyModel_Click" />

                        <!-- Mở trên Web -->
                        <ui:Button x:Name="BtnOpenInBrowser"
                                   Icon="{ui:SymbolIcon Globe24}" Content="Mở trên Web"
                                   Height="30" Padding="10,0" Margin="0,0,6,4"
                                   ToolTip="Mở mô hình trực tiếp trên trình duyệt web mặc định"
                                   Click="BtnOpenInBrowser_Click" />

                        <!-- Sao chép HTML -->
                        <ui:Button x:Name="BtnCopyHtml"
                                   Icon="{ui:SymbolIcon Copy24}" Content="Sao chép HTML"
                                   Height="30" Padding="10,0" Margin="0,0,6,4"
                                   ToolTip="Sao chép toàn bộ mã nguồn HTML vào Clipboard"
                                   Click="BtnCopyHtml_Click" />

                        <!-- Xóa khỏi kho (Chỉ áp dụng cho mô hình cá nhân) -->
                        <ui:Button x:Name="BtnDeleteModel" Appearance="Danger"
                                   Icon="{ui:SymbolIcon Delete24}" Content="Xóa"
                                   Height="30" Padding="10,0" Margin="0,0,6,4" Visibility="Collapsed"
                                   ToolTip="Xóa mô hình cá nhân này khỏi kho lưu trữ"
                                   Click="BtnDeleteModel_Click" />
                    </WrapPanel>

                    <!-- Xem trước mã nguồn HTML -->
                    <Border Grid.Row="2" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="6">
                        <TextBox x:Name="TxtCodePreview"
                                 IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="Consolas, 'Cascadia Code', monospace" FontSize="11"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Border>

                    <!-- Footer thông tin -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:SymbolIcon Symbol="Info24" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtDetailStatus" Text="Nhấn Enter hoặc đúp chuột vào danh sách để nạp nhanh." FontSize="10.5"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</Window>
