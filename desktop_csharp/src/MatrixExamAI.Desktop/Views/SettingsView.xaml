<UserControl x:Class="MatrixExamAI.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,20,20">
            <!-- Header -->
            <TextBlock Text="Cài đặt Hệ thống &amp; Bản quyền" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="Cấu hình nhà cung cấp trí tuệ nhân tạo, khóa API xoay vòng và kiểm tra trạng thái tiện ích Word" 
                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,24" />

            <!-- Section 1: AI Provider & Multi-Key Pool (Đồng bộ toàn diện MEA v5.0) -->
            <ui:CardExpander Header="Trí tuệ Nhân tạo &amp; API Key" 
                             Icon="{ui:SymbolIcon Brain24}"
                             IsExpanded="True" Margin="0,0,0,16">
                <StackPanel Margin="0,8,0,0">
                    <!-- Hàng 1: Nhà cung cấp AI -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" MinWidth="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nhà cung cấp AI:" VerticalAlignment="Center" FontWeight="Medium" />
                        <ComboBox x:Name="CmbProvider" Grid.Column="1" SelectionChanged="CmbProvider_SelectionChanged">
                            <ComboBoxItem Content="Google Gemini (Trực tiếp từ Google AI Studio)" Tag="Google Gemini" />
                            <ComboBoxItem Content="9Router (Local Aggregator - Cổng 20128)" Tag="9Router" />
                            <ComboBoxItem Content="Anthropic Claude (Claude Sonnet / Opus)" Tag="Anthropic Claude" />
                            <ComboBoxItem Content="DeepSeek (V3.2 / R1 Reasoning)" Tag="DeepSeek" />
                            <ComboBoxItem Content="OpenAI GPT (GPT-4o / GPT-4.5)" Tag="OpenAI GPT" />
                        </ComboBox>
                    </Grid>

                    <!-- Hàng 2: Mô hình AI -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" MinWidth="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Mô hình AI mặc định:" VerticalAlignment="Center" FontWeight="Medium" />
                        <ComboBox x:Name="CmbDefaultModel" Grid.Column="1" SelectionChanged="CmbDefaultModel_SelectionChanged" />
                        <ui:Button x:Name="BtnRefreshModels" Grid.Column="2" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}" 
                                   Margin="6,0,0,0" Padding="8,4" ToolTip="Tải lại danh sách mô hình đang trực tuyến từ 9Router" Click="BtnRefreshModels_Click" />
                    </Grid>

                    <!-- Hàng 3: API Key (mỗi dòng 1 key) + Nút chức năng phụ trợ -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" MinWidth="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="API Key (mỗi dòng 1 key):" FontWeight="Medium" />
                            <TextBlock x:Name="TxtKeyStatus" Text="Chưa có key" FontSize="11" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Thanh công cụ nhỏ hỗ trợ lấy key, chọn file, ẩn/hiện, xóa -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                                <ui:Button x:Name="BtnGetKeyUrl" Appearance="Secondary" Icon="{ui:SymbolIcon Open24}"
                                           Content="Lấy API key" Padding="8,3" FontSize="11" Margin="0,0,4,0"
                                           Click="BtnGetKeyUrl_Click" ToolTip="Mở trang lấy API Key chính thức của nhà cung cấp" />
                                <ui:Button x:Name="BtnPickKeyFile" Appearance="Secondary" Icon="{ui:SymbolIcon DocumentFolder24}"
                                           Content="Chọn file api.txt" Padding="8,3" FontSize="11" Margin="0,0,4,0"
                                           Click="BtnPickKeyFile_Click" ToolTip="Nạp danh sách API Key từ tệp văn bản .txt" />
                                <ui:Button x:Name="BtnToggleKey" Appearance="Secondary" Icon="{ui:SymbolIcon Eye24}"
                                           Content="Hiện/Ẩn" Padding="8,3" FontSize="11" Margin="0,0,4,0"
                                           Click="BtnToggleKey_Click" ToolTip="Ẩn/Hiện nội dung API Key" />
                                <ui:Button x:Name="BtnClearKey" Appearance="Secondary" Icon="{ui:SymbolIcon Delete24}"
                                           Content="Xóa key" Padding="8,3" FontSize="11"
                                           Click="BtnClearKey_Click" ToolTip="Xóa API Key đang nhập" />
                            </StackPanel>

                            <!-- Ô nhập nhiều dòng cho phép dán nhiều API Key -->
                            <ui:TextBox x:Name="TxtApiKey" Grid.Row="1" Height="80"
                                        AcceptsReturn="True" TextWrapping="NoWrap"
                                        VerticalContentAlignment="Top"
                                        FontFamily="Consolas, 'Cascadia Code', 'Segoe UI', monospace" FontSize="11.5"
                                        PlaceholderText="Dán một hoặc nhiều API Key tại đây (mỗi dòng 1 key để tự động xoay vòng khi chạm hạn mức)..."
                                        TextChanged="TxtApiKey_TextChanged" />
                        </Grid>
                    </Grid>

                    <!-- Hàng 4: Tự động xoay vòng Key -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" MinWidth="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tự động xoay vòng Key:" VerticalAlignment="Center" FontWeight="Medium" />
                        <ui:ToggleSwitch x:Name="ChkKeyRotation" Grid.Column="1" IsChecked="True" Content="Bật chế độ Multi-Key Rotation khi chạm Rate Limit (HTTP 429)" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <ui:Button x:Name="BtnTestConnection" Appearance="Secondary" Icon="{ui:SymbolIcon Flash24}" Content="Kiểm tra kết nối AI" Padding="14,6" Margin="0,0,8,0" Click="BtnTestConnection_Click" ToolTip="Kiểm tra kết nối tới Google Gemini hoặc 9Router Local" />
                        <ui:Button x:Name="BtnSaveSettings" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Content="Lưu Cấu Hình" Padding="16,6" Click="BtnSaveSettings_Click" ToolTip="Lưu cấu hình hệ thống và API Keys (Ctrl + S)" />
                    </StackPanel>

                    <ui:InfoBar x:Name="InfoSettingsNotification" Margin="0,10,0,0" IsOpen="False" />
                </StackPanel>
            </ui:CardExpander>

            <!-- Section 2: Vị trí Lưu trữ & Đường dẫn Thư mục -->
            <ui:CardExpander Header="Vị trí Lưu trữ &amp; Thư mục Dữ liệu" 
                             Icon="{ui:SymbolIcon FolderOpen24}"
                             IsExpanded="True" Margin="0,0,0,16">
                <StackPanel Margin="0,8,0,0">
                    <!-- Hàng 1: Thư mục xuất tài liệu / Đề thi mặc định -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" MinWidth="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Thư mục xuất Đề thi / Word:" FontWeight="Medium" />
                            <TextBlock Text="Vị trí lưu mặc định khi xuất file Word, PDF, LaTeX" 
                                       FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:TextBox x:Name="TxtDefaultExportPath" Grid.Column="1" Height="28" FontSize="11" 
                                    VerticalContentAlignment="Center" Margin="0,0,6,0" IsReadOnly="True" />
                        <ui:Button x:Name="BtnBrowseExportPath" Grid.Column="2" Appearance="Primary" Icon="{ui:SymbolIcon FolderOpen24}" 
                                   Content="Chọn thư mục" Height="28" Padding="10,0" Margin="0,0,6,0" FontSize="11"
                                   Click="BtnBrowseExportPath_Click" ToolTip="Chọn thư mục trên máy tính để lưu tài liệu xuất ra" />
                        <ui:Button x:Name="BtnOpenExportPath" Grid.Column="3" Appearance="Secondary" Icon="{ui:SymbolIcon Open24}" 
                                   Content="Mở thư mục" Height="28" Padding="10,0" FontSize="11"
                                   Click="BtnOpenExportPath_Click" ToolTip="Mở thư mục xuất tài liệu trong File Explorer" />
                    </Grid>

                    <!-- Hàng 2: Thư mục Ngân hàng câu hỏi (NHCH / Database) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" MinWidth="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Thư mục Ngân hàng câu hỏi:" FontWeight="Medium" />
                            <TextBlock Text="Nơi lưu trữ file cơ sở dữ liệu SQLite (.db)" 
                                       FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:TextBox x:Name="TxtQuestionBankPath" Grid.Column="1" Height="28" FontSize="11" 
                                    VerticalContentAlignment="Center" Margin="0,0,6,0" IsReadOnly="True" />
                        <ui:Button x:Name="BtnBrowseBankPath" Grid.Column="2" Appearance="Primary" Icon="{ui:SymbolIcon FolderOpen24}" 
                                   Content="Chọn thư mục" Height="28" Padding="10,0" Margin="0,0,6,0" FontSize="11"
                                   Click="BtnBrowseBankPath_Click" ToolTip="Chọn thư mục lưu cơ sở dữ liệu Ngân hàng câu hỏi" />
                        <ui:Button x:Name="BtnOpenBankPath" Grid.Column="3" Appearance="Secondary" Icon="{ui:SymbolIcon Open24}" 
                                   Content="Mở thư mục" Height="28" Padding="10,0" FontSize="11"
                                   Click="BtnOpenBankPath_Click" ToolTip="Mở thư mục cơ sở dữ liệu Ngân hàng câu hỏi" />
                    </Grid>

                    <!-- Hàng 3: Tự động mở file sau khi xuất -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" MinWidth="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tự động mở sau khi xuất:" VerticalAlignment="Center" FontWeight="Medium" />
                        <ui:ToggleSwitch x:Name="ChkOpenAfterExport" Grid.Column="1" IsChecked="True" 
                                         Content="Tự động mở file Word hoặc thư mục lưu trữ ngay khi xuất hoàn tất" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- Section 3: Word Add-in & Toolchain -->
            <ui:CardExpander Header="Tiện ích Mở rộng Microsoft Word" 
                             Icon="{ui:SymbolIcon DocumentOnePage24}"
                             IsExpanded="True" Margin="0,0,0,16">
                <StackPanel Margin="0,8,0,0">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Trạng thái Word Add-in:" FontWeight="Medium" />
                            <TextBlock Text="Đã đăng ký HKCU Ribbon MatrixExamAI (Word 2016/2019/2021/365)" 
                                        FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:Button x:Name="BtnSyncAddin" Grid.Column="1" Appearance="Primary" Content="Kích hoạt lại Add-in" Click="BtnSyncAddin_Click" ToolTip="Kích hoạt lại Add-in trong Windows Registry" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Bộ biên dịch TeXLive / pdflatex:" FontWeight="Medium" />
                            <TextBlock Text="Dùng để xuất vector EMF / SVG sắc nét 600 DPI khi vẽ hình TikZ" 
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1A10B981" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="Đã sẵn sàng" Foreground="#10B981" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- Section 3: Performance & Graphics -->
            <ui:CardExpander Header="Hiệu năng &amp; Tăng tốc Đồ họa" 
                             Icon="{ui:SymbolIcon DesktopPulse24}"
                             IsExpanded="False" Margin="0,0,0,16">
                <StackPanel Margin="0,8,0,0">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" MinWidth="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tăng tốc phần cứng GPU:" VerticalAlignment="Center" FontWeight="Medium" />
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="True" Content="Kích hoạt tăng tốc đồ họa phần cứng GPU (120 FPS)" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" MinWidth="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hiệu ứng nền cửa sổ:" VerticalAlignment="Center" FontWeight="Medium" />
                        <ComboBox Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="Windows 11 Mica (Kính mờ thông minh)" />
                            <ComboBoxItem Content="Windows 11 Acrylic (Trong suốt)" />
                            <ComboBoxItem Content="Solid (Đơn sắc cổ điển)" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- Section 4: Auto-Update -->
            <ui:CardExpander Header="Cập nhật Ứng dụng (Tự động cập nhật)" 
                             Icon="{ui:SymbolIcon ArrowDownload24}"
                             IsExpanded="True" Margin="0,0,0,16">
                <StackPanel Margin="0,8,0,0">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Phiên bản hiện tại:" FontWeight="Medium" />
                            <TextBlock Text="MatrixExamAI Pro v5.3.0.9" 
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                            <TextBlock x:Name="TxtLastCheckUpdate" Text="Lần cập nhật gần nhất: Chưa kiểm tra" 
                                       FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ui:Button x:Name="BtnCheckUpdateSettings" Grid.Column="1" Appearance="Primary" 
                                   Icon="{ui:SymbolIcon ArrowSync24}" Content="Kiểm tra bản cập nhật" 
                                   Click="BtnCheckUpdateSettings_Click" ToolTip="Kiểm tra bản phát hành mới nhất" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Kênh phân phối bản cập nhật:" FontWeight="Medium" />
                            <TextBlock Text="Hệ thống máy chủ phân phối tự động" 
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1A0D9488" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="Trực tiếp" Foreground="#0D9488" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- Section 5: Bản quyền & Kích hoạt Trực tuyến -->
            <ui:CardExpander Header="Bản quyền &amp; Kích hoạt Trực tuyến" 
                             Icon="{ui:SymbolIcon Key24}"
                             IsExpanded="True" Margin="0,0,0,16">
                <StackPanel Margin="0,8,0,0">
                    <!-- Hàng 1: Trạng thái bản quyền & Chủ sở hữu -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Trạng thái giấy phép:" FontWeight="Medium" VerticalAlignment="Center" />
                                <Border x:Name="BadgeSettingsLicense" Background="#1A10B981" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSettingsLicenseBadge" Text="ĐÃ KÍCH HOẠT PRO" Foreground="#10B981" FontSize="10" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtSettingsLicenseOwner" Text="Chủ sở hữu: Thầy Đỗ Minh (Đỗ Miinh Math) • Hạn dùng: Vĩnh viễn" 
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button x:Name="BtnCheckLicenseSettings" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowSync24}" 
                                       Content="Kiểm tra Trực tuyến" Padding="12,6" Margin="0,0,8,0" Click="BtnCheckLicenseSettings_Click" 
                                       ToolTip="Đồng bộ và kiểm tra trạng thái giấy phép trực tuyến" />
                            <ui:Button x:Name="BtnOpenActivationDialog" Appearance="Primary" Icon="{ui:SymbolIcon Key24}" 
                                       Content="Hộp thoại Kích hoạt" Padding="14,6" Click="BtnOpenActivationDialog_Click" 
                                       ToolTip="Mở cửa sổ nhập mã bản quyền hoặc quét VietQR kích hoạt" />
                        </StackPanel>
                    </Grid>

                    <!-- Hàng 2: Mã máy phần cứng (Machine ID) -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Mã định danh máy tính (Machine ID):" FontWeight="Medium" />
                            <TextBlock x:Name="TxtSettingsMachineId" Text="6A12-48D4-2666" FontFamily="Consolas, monospace" FontSize="13" FontWeight="Bold" 
                                       Foreground="#0284C7" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:Button x:Name="BtnCopyMachineIdSettings" Grid.Column="1" Appearance="Secondary" Icon="{ui:SymbolIcon Copy24}" 
                                   Content="Sao chép" Padding="10,4" Click="BtnCopyMachineIdSettings_Click" ToolTip="Sao chép mã máy tính để gửi cho Admin" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- Section 6: Thông tin Ứng dụng & Tác giả -->
            <ui:CardExpander Header="Thông tin Phần mềm &amp; Tác giả" 
                             Icon="{ui:SymbolIcon Info24}"
                             IsExpanded="True" Margin="0,0,0,16">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="/MatrixExamAI.Desktop;component/Assets/logo.png" Width="64" Height="64" Margin="0,0,20,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="MatrixExamAI Pro v5.3.0.10" FontWeight="Bold" FontSize="15" />
                        <TextBlock Text="Phần mềm Trợ lý Soạn đề &amp; Chuyển đổi Tài liệu AI" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Tác giả: Thầy Đỗ Minh (Đỗ Miinh Math)" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </ui:CardExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
