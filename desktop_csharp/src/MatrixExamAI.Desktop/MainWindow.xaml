<ui:FluentWindow x:Class="MatrixExamAI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:MatrixExamAI.Desktop.Views"
        mc:Ignorable="d"
        Title="MatrixExamAI Pro v5.3.0.0" 
        Icon="Assets/app.ico"
        Height="720" Width="1280"
        MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Fluent TitleBar -->
        <ui:TitleBar x:Name="MainTitleBar" Grid.Row="0" Title="MatrixExamAI Pro v5.3.0.26 • Trợ lý Soạn đề &amp; Chuyển đổi Tài liệu AI">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image Source="Assets/logo.png" Width="24" Height="24" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="MatrixExamAI Pro" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                    <Border Background="#1A0D9488" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Bản quyền PRO" FontSize="10" Foreground="#0D9488" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAppVersionTop" Text="v5.3.0.26" FontSize="10" Foreground="#38BDF8" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <ui:Button x:Name="BtnCheckUpdate" Appearance="Transparent" 
                               Icon="{ui:SymbolIcon ArrowDownload24}" 
                               ToolTip="Kiểm tra bản cập nhật mới"
                               Click="BtnCheckUpdate_Click" Margin="0,0,4,0" />
                    <ui:Button x:Name="BtnToggleTheme" Appearance="Transparent" 
                               Icon="{ui:SymbolIcon DarkTheme24}" 
                               ToolTip="Chuyển đổi giao diện Sáng / Tối (Ctrl + Alt + T)"
                               Click="BtnToggleTheme_Click" Margin="0,0,4,0" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- 2. Main Two-Column Navigation Shell (Sidebar co giãn tự động Cột 0, Content Cột 1) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Cột 0: NavigationView Sidebar -->
            <ui:NavigationView x:Name="NavView" Grid.Column="0"
                               PaneTitle="Phân hệ chính"
                               IsBackButtonVisible="Collapsed"
                               PaneDisplayMode="Left"
                               OpenPaneLength="220"
                               CompactPaneLength="50"
                               IsPaneOpen="True"
                               IsPaneToggleVisible="True"
                               SelectionChanged="NavView_SelectionChanged">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem x:Name="NavItemDashboard" Content="Tổng quan Dashboard" Tag="dashboard" Icon="{ui:SymbolIcon Home24}" Click="NavItem_Click" ToolTip="Tổng quan hệ thống (Ctrl + 1)" />
                    <ui:NavigationViewItem x:Name="NavItemConvert" Content="Convert" Tag="convert" Icon="{ui:SymbolIcon ArrowSync24}" Click="NavItem_Click" ToolTip="Chuyển đổi &amp; Xuất Word (Ctrl + 2)" />
                    <ui:NavigationViewItem x:Name="NavItemMatrix" Content="Soạn đề theo Ma trận" Tag="matrix" Icon="{ui:SymbolIcon Sparkle24}" Click="NavItem_Click" ToolTip="Soạn đề theo ma trận BGD (Ctrl + 3)" />
                    <ui:NavigationViewItem x:Name="NavItemTikz" Content="AI Vẽ hình toán TikZ" Tag="tikz" Icon="{ui:SymbolIcon Shapes24}" Click="NavItem_Click" ToolTip="Vẽ hình TikZ &amp; Đồ thị (Ctrl + 4)" />
                    <ui:NavigationViewItem x:Name="NavItemHtmlModel" Content="Mô hình Toán học HTML" Tag="html_model" Icon="{ui:SymbolIcon Cube24}" Click="NavItem_Click" ToolTip="Mô hình Toán học &amp; Khoa học 3D HTML (Ctrl + 0)" />
                    <ui:NavigationViewItem x:Name="NavItemShuffle" Content="Trộn đề &amp; Phiếu OMR" Tag="shuffle" Icon="{ui:SymbolIcon ArrowShuffle24}" Click="NavItem_Click" ToolTip="Trộn mã đề thi (Ctrl + 5)" />
                    <ui:NavigationViewItem x:Name="NavItemBank" Content="Ngân hàng câu hỏi" Tag="bank" Icon="{ui:SymbolIcon Archive24}" Click="NavItem_Click" ToolTip="Ngân hàng câu hỏi (Ctrl + 6)" />
                    <ui:NavigationViewItem x:Name="NavItemAiUsage" Content="Thống kê AI" Tag="ai_usage" Icon="{ui:SymbolIcon DataUsage24}" Click="NavItem_Click" ToolTip="Thống kê lưu lượng &amp; quota AI (Ctrl + 7)" />
                    <!-- Thẩm định đề thi (QC) đã ẩn theo yêu cầu người dùng -->
                    <ui:NavigationViewItem x:Name="NavItemQc" Content="Thẩm định đề thi (QC)" Tag="qc" Icon="{ui:SymbolIcon CheckmarkSquare24}" Click="NavItem_Click" ToolTip="Thẩm định chất lượng đề" Visibility="Collapsed" />
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem x:Name="NavItemSettings" Content="Cài đặt &amp; Bản quyền" Tag="settings" Icon="{ui:SymbolIcon Settings24}" Click="NavItem_Click" ToolTip="Cấu hình hệ thống (Ctrl + 8)" />
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <!-- Cột 1: Vùng hiển thị nội dung trực tiếp (Content Control tự thích ứng) -->
            <Border Grid.Column="1" Background="{DynamicResource ApplicationBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Thanh Quick Action Bar Tạo đề AI (ảnh 2) -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="BtnQuickGen" Style="{DynamicResource AccentVibrantButtonStyle}" Margin="0,0,6,0" Height="28" Padding="10,0"
                                       Background="#D97706" Foreground="White"
                                       Icon="{ui:SymbolIcon Flash24}" Content="Tạo đề nhanh" FontSize="11" FontWeight="SemiBold"
                                       Click="BtnQuickGen_Click" ToolTip="Khởi tạo nhanh cấu trúc đề thi chuẩn BGD 2025" />
                            <ui:Button x:Name="BtnAiMatrix" Style="{DynamicResource AccentVibrantButtonStyle}" Margin="0,0,6,0" Height="28" Padding="10,0"
                                       Background="#7C3AED" Foreground="White"
                                       Icon="{ui:SymbolIcon Bot24}" Content="Tạo ma trận AI" FontSize="11" FontWeight="SemiBold"
                                       Click="BtnAiMatrix_Click" ToolTip="Mở phân hệ ma trận và sinh khung đề bằng AI" />
                            <ui:Button x:Name="BtnSmartPrompt" Style="{DynamicResource AccentVibrantButtonStyle}" Margin="0,0,6,0" Height="28" Padding="10,0"
                                       Background="#8B5CF6" Foreground="White"
                                       Icon="{ui:SymbolIcon Chat24}" Content="Smart Prompt" FontSize="11" FontWeight="SemiBold"
                                       Click="BtnSmartPrompt_Click" ToolTip="Nạp các prompt AI chuẩn hóa đề thi" />
                            <ui:Button x:Name="BtnChooseSource" Style="{DynamicResource AccentVibrantButtonStyle}" Margin="0,0,6,0" Height="28" Padding="10,0"
                                       Background="#0284C7" Foreground="White"
                                       Icon="{ui:SymbolIcon Target24}" Content="Nguồn tạo đề" FontSize="11" FontWeight="SemiBold"
                                       Click="BtnChooseSource_Click" ToolTip="Chọn tệp nguồn từ máy tính để phân tích và tạo đề" />
                            <ui:Button x:Name="BtnAiGen" Style="{DynamicResource AccentVibrantButtonStyle}" Margin="0,0,6,0" Height="28" Padding="12,0"
                                       Background="#059669" Foreground="White"
                                       Icon="{ui:SymbolIcon Sparkle24}" Content="Tạo đề bằng AI" FontSize="11" FontWeight="Bold"
                                       Click="BtnAiGen_Click" ToolTip="Kích hoạt trợ lý AI xử lý hoặc sinh đề tức thì" />
                            <ui:Button x:Name="BtnQuickShuffle" Style="{DynamicResource AccentVibrantButtonStyle}" Margin="0,0,6,0" Height="28" Padding="10,0"
                                       Background="#0284C7" Foreground="White"
                                       Icon="{ui:SymbolIcon ArrowShuffle24}" Content="Trộn đề thi" FontSize="11" FontWeight="SemiBold"
                                       Click="BtnQuickShuffle_Click" ToolTip="Chuyển ngay sang phân hệ trộn đề hoán vị" />
                            <ui:Button x:Name="BtnGuide" Style="{DynamicResource AccentVibrantButtonStyle}" Margin="0,0,6,0" Height="28" Padding="10,0"
                                       Background="#475569" Foreground="White"
                                       Icon="{ui:SymbolIcon BookOpen24}" Content="Hướng dẫn" FontSize="11" FontWeight="SemiBold"
                                       Click="BtnGuide_Click" ToolTip="Xem hướng dẫn sử dụng chi tiết (Ctrl + H)" />
                        </WrapPanel>
                    </Border>

                    <!-- Banner Thông báo Bản cập nhật mới -->
                    <Border x:Name="BorderUpdateNotice" Grid.Row="1" Margin="16,8,16,4" Visibility="Collapsed"
                            Background="#0F0284C7" BorderBrush="#330284C7" BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="#0284C7" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtUpdateNoticeTitle" Text="Đã có bản cập nhật mới!" FontWeight="SemiBold" FontSize="12.5" Foreground="#0284C7" />
                                <TextBlock x:Name="TxtUpdateNoticeMessage" Text="Phiên bản mới đã sẵn sàng tải về." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:Button x:Name="BtnUpdateNoticeAction" Grid.Column="2" Appearance="Primary"
                                       Icon="{ui:SymbolIcon ArrowDownload24}" Content="Cập nhật ngay"
                                       Height="28" Padding="12,0" FontSize="11" Click="BtnUpdateNoticeAction_Click" Margin="0,0,8,0"
                                       ToolTip="Cập nhật lên phiên bản mới nhất" />
                            <ui:Button x:Name="BtnCloseUpdateNotice" Grid.Column="3" Appearance="Transparent"
                                       Icon="{ui:SymbolIcon Dismiss24}" Height="28" Width="28" Padding="0" Click="BtnCloseUpdateNotice_Click" 
                                       ToolTip="Đóng thông báo cập nhật" />
                        </Grid>
                    </Border>

                    <ContentControl Grid.Row="2" x:Name="MainContentFrame" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Bottom Modern StatusBar -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                Padding="16,4">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" />
                    <TextBlock Text="Trạng thái: Hoạt động ổn định (Tối ưu phần cứng)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="6,0" />
                    <TextBlock Text="Mô hình AI: gemini-3.8-flash / 9Router" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="6,0" />
                    <TextBlock Text="Công thức: ${...}$ kẹp chuẩn Word" FontSize="11" FontWeight="SemiBold" Foreground="#0D9488" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                        <TextBlock x:Name="TxtAppVersionBottom" Text="v5.3.0.26" FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="RAM: ~42MB" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="6,0" />
                    <TextBlock x:Name="TxtStatusBarLicense" Text="Bản quyền: Thầy Đỗ Minh (PRO)" FontSize="11" FontWeight="SemiBold" 
                               Foreground="#0284C7" Cursor="Hand" ToolTip="Nhấn để mở cửa sổ Kích hoạt bản quyền trực tuyến" 
                               MouseLeftButtonDown="TxtStatusBarLicense_MouseLeftButtonDown" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
