# ============================================================================
# MEA v4 Desktop — Environment Variables
# Copy file này thành `.env` và điền giá trị.
# ============================================================================

# ── Supabase (DÙNG CHUNG với Web LMS v5) ────────────────────────────────────
# Lấy từ:  https://supabase.com → Project → Settings → API
# QUAN TRỌNG: cùng URL/KEY với MEA_v5_web/backend/.env và apps/web/.env.local
#             để câu hỏi upload từ Desktop hiển thị NGAY trên Web LMS.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOi...                  # anon public key (không phải service_role)

# ── License system cũ (GAS — vẫn giữ để fallback nếu cần) ───────────────────
EXAMAI_GAS_URL=https://script.google.com/macros/s/YOUR_GAS_DEPLOY_ID/exec
EXAMAI_GAS_SECRET=your_gas_secret_here

# ── CORS origins (tuỳ chọn, cho mea_v3 local Flask API) ─────────────────────
EXAMAI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── (Tuỳ chọn) URL backend FastAPI v5 ───────────────────────────────────────
# Bật khi muốn EXE gọi /v1/desktop/sync/* thay vì ghi thẳng Supabase
# Hiện chưa bắt buộc — code mặc định ghi thẳng (xem nhch_upload_batch).
MEA_API_URL=http://localhost:8000
